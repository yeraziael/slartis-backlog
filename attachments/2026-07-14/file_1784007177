version: 1.1
default_cloud_model: FLASH_FREE
default_local_coding_model: LOCAL_CODER
default_local_general_model: LOCAL_FAST
classes:
  LOCAL_FAST:
    patterns:
      - "qwen3.5:4b"
      - "qwen2.5:3b"
