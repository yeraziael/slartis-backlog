    patterns:
      - "terra"
      - "deepseek-v4-pro"
  SOL:
    patterns:
      - "sol"
rules:
  documentation: FLASH_FREE
  summarization: FLASH_FREE
  repository_scan: FLASH_FREE
  log_analysis: FLASH_FREE
  ticket_management: FLASH_FREE
