+#!/usr/bin/env python3
+"""PW-I08 blackbox fixtures for deterministic evidence bundling."""
+import json
+import shutil
+import subprocess
+import sys
+import tempfile
+import zipfile
+from pathlib import Path
+
+
+HERE = Path(__file__).resolve().parent
+ASSEMBLE = HERE / "bundle-assemble.py"
+VALIDATE = HERE / "bundle-validate.py"
+
+
+def manifest(result: str) -> dict:
+    return {
+        "manifest_version": 1,
+        "source_repository": "Homelab/Architecture",
+        "source_commit": "0" * 40,
+        "architecture_repository": "Homelab/Architecture",
+        "architecture_commit": "0" * 40,
+        "service_name": "playwright-platform",
+        "service_version": "self-test",
+        "service_version_source": "runner_image",
+        "runner_image": "example/playwright@sha256:" + "0" * 64,
+        "environment": "local",
+        "suite": "platform",
+        "result": result,
+        "exit_code": {"pass": 0, "fail": 1, "prerequisite_error": 2}[result],
+        "duration_seconds": 0,
+        "timestamp": "2026-07-26T00:00:00Z",
+        "tests": {"total": 1, "passed": result == "pass", "failed": result == "fail", "prerequisite_errors": result == "prerequisite_error", "skipped": 0},
+        "runtime": {"runner_containers": []},
+        "outcomes": [],
+    }
+
+
+def write_input(path: Path, result: str, extra: bool = False) -> None:
+    path.mkdir()
+    (path / "manifest.json").write_text(json.dumps(manifest(result)) + "\n")
+    (path / "junit.xml").write_text("<testsuite/>\n")
+    if result == "fail":
+        (path / "screenshot.png").write_bytes(b"\x89PNG\r\n\x1a\n")
+        with zipfile.ZipFile(path / "trace.zip", "w") as archive:
+            archive.writestr("trace.txt", "clean trace")
+    if extra:
+        (path / "forbidden.bin").write_bytes(b"not publishable")
+
+
+def run(*args: str, expected: int = 0) -> subprocess.CompletedProcess:
+    result = subprocess.run([sys.executable, *args], capture_output=True, text=True)
+    if result.returncode != expected:
+        raise AssertionError(f"{args[0]} returned {result.returncode}: {result.stderr}")
+    return result
+
+
+def main() -> None:
+    with tempfile.TemporaryDirectory() as temp:
+        root = Path(temp)
+        for result in ("pass", "fail", "prerequisite_error"):
+            source = root / f"{result}-input"
+            bundle = root / f"{result}-bundle"
+            write_input(source, result)
+            run(str(ASSEMBLE), str(source), str(bundle))
+            run(str(VALIDATE), str(bundle))
+
+        source = root / "deterministic-input"
+        first = root / "first"
+        second = root / "second"
+        write_input(source, "fail")
+        run(str(ASSEMBLE), str(source), str(first))
+        run(str(ASSEMBLE), str(source), str(second))
+        if (first / "inventory.json").read_bytes() != (second / "inventory.json").read_bytes():
+            raise AssertionError("identical input produced different inventories")
+
+        missing = root / "missing-input"
+        missing.mkdir()
+        (missing / "manifest.json").write_text(json.dumps(manifest("pass")))
+        run(str(ASSEMBLE), str(missing), str(root / "missing-bundle"), expected=2)
+
+        unsafe = root / "unsafe-input"
+        write_input(unsafe, "pass", extra=True)
+        run(str(ASSEMBLE), str(unsafe), str(root / "unsafe-bundle"), expected=2)
+
+    print("PW-I08: BUNDLE SELF-TEST PASSED")
+
+
+if __name__ == "__main__":
+    main()
