+#!/usr/bin/env python3
+"""Check image file metadata for prohibited patterns.
+Usage: sanitise_image.py <image_file> <patterns_file>
+Exit: 0 = clean, 1 = prohibited content detected, 2 = error
+"""
+import re
+import sys
+
+def main():
+    if len(sys.argv) < 3:
+        print("USAGE: sanitise_image.py <image_file> <patterns_file>", file=sys.stderr)
+        sys.exit(2)
+
+    image_path = sys.argv[1]
+    patterns_path = sys.argv[2]
+
+    with open(patterns_path) as f:
+        raw_patterns = [l.strip() for l in f if l.strip() and not l.startswith("#")]
+
+    compiled = []
+    for p in raw_patterns:
+        try:
+            compiled.append(re.compile(p, re.IGNORECASE))
+        except re.error:
+            pass
+
+    if not compiled:
+        print("ERROR: no valid patterns", file=sys.stderr)
+        sys.exit(2)
+
+    try:
+        with open(image_path, "rb") as f:
+            data = f.read()
+
+        strings = []
+        cur = []
+        for b in data:
+            if b == 0:
+                if len(cur) > 4:
+                    strings.append(bytes(cur).decode("utf-8", errors="replace"))
+                cur = []
+            else:
+                cur.append(b)
+        if len(cur) > 4:
+            strings.append(bytes(cur).decode("utf-8", errors="replace"))
+
+        for s in strings:
+            for pattern in compiled:
+                if pattern.search(s):
+                    sys.exit(1)
+        sys.exit(0)
+    except Exception as e:
+        print(f"ERROR: {e}", file=sys.stderr)
+        sys.exit(2)
+
+if __name__ == "__main__":
+    main()
