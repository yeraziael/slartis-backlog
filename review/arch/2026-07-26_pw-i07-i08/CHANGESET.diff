+#!/usr/bin/env bash
+# PW-I07: sanitise.sh — Evidence sanitisation publication gate.
+# Inspects publishable evidence files for prohibited patterns.
+# Fails closed: any match blocks publication.
+# Never reproduces matched values in output.
+#
+# Usage: sanitise.sh <evidence-dir>
+# Exit: 0 = clean, 1 = prohibited content detected, 2 = scan error
+
+set -euo pipefail
+
+if [ $# -lt 1 ]; then
+  echo "PW-I07: USAGE: sanitise.sh <evidence-dir>" >&2
+  exit 2
+fi
+
+EVIDENCE_DIR="$1"
+if [ ! -d "$EVIDENCE_DIR" ]; then
+  echo "PW-I07: FAIL — evidence directory not found: $EVIDENCE_DIR" >&2
+  exit 2
+fi
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+PATTERNS_FILE="$SCRIPT_DIR/sanitise-patterns.txt"
+
+if [ ! -f "$PATTERNS_FILE" ]; then
+  echo "PW-I07: FAIL — patterns file not found: $PATTERNS_FILE" >&2
+  exit 2
+fi
+
+CHECKS_FAILED=0
+TMPDIR="$(mktemp -p "${TMPDIR:-/tmp}" -d sanitise.XXXXXX 2>/dev/null || mktemp -d)"
+PATTERNS_TMP="$TMPDIR/patterns.txt"
+cleanup() { rm -rf "$TMPDIR"; }
+trap cleanup EXIT
+
+# Strip comment/blank lines from patterns file for grep
+grep -v '^#' "$PATTERNS_FILE" | grep -v '^[[:space:]]*$' > "$PATTERNS_TMP" || true
+
+if [ ! -s "$PATTERNS_TMP" ]; then
+  echo "PW-I07: FAIL — no active patterns in $PATTERNS_FILE" >&2
+  exit 2
+fi
+
+sanitise_file() {
+  local file="$1"
+  local relpath="${file#$EVIDENCE_DIR/}"
+
+  # Determine how to inspect based on file extension/content
+  case "$file" in
+    *.json|*.xml|*.txt|*.md|*.log|*.env|*.yml|*.yaml|*.html|*.htm|*.js|*.ts)
+      # Text files: direct grep
+      if grep -qiEf "$PATTERNS_TMP" "$file" > /dev/null 2>&1; then
+        echo "PW-I07: BLOCKED — '$relpath' matches prohibited pattern" >&2
+        CHECKS_FAILED=1
+      fi
+      ;;
+    *.zip)
+      # ZIP files: extract text content, scan without writing
+      if command -v unzip >/dev/null 2>&1; then
+        if unzip -p "$file" 2>/dev/null | grep -qiEf "$PATTERNS_TMP" > /dev/null 2>&1; then
+          echo "PW-I07: BLOCKED — '$relpath' contains prohibited pattern in archived content" >&2
+          CHECKS_FAILED=1
+        fi
+      elif command -v python3 >/dev/null 2>&1; then
+        if python3 "$SCRIPT_DIR/sanitise_zip.py" "$file" "$PATTERNS_TMP" >/dev/null 2>&1; then
+          : # clean
+        else
+          echo "PW-I07: BLOCKED — '$relpath' contains prohibited pattern in archived content" >&2
+          CHECKS_FAILED=1
+        fi
+      else
+        echo "PW-I07: FAIL — no unzip or python3 available to scan '$relpath'" >&2
+        CHECKS_FAILED=1
+      fi
+      ;;
+    *.png|*.jpg|*.jpeg|*.gif)
+      # Images: check file metadata for embedded text
+      if command -v python3 >/dev/null 2>&1; then
+        if python3 "$SCRIPT_DIR/sanitise_image.py" "$file" "$PATTERNS_TMP" >/dev/null 2>&1; then
+          : # clean
+        else
+          echo "PW-I07: BLOCKED — '$relpath' contains prohibited pattern in image metadata" >&2
+          CHECKS_FAILED=1
+        fi
+      else
+        echo "PW-I07: WARNING — cannot scan image metadata in '$relpath' (no python3)" >&2
+      fi
+      ;;
+    *)
+      # Unknown type: skip binary files safely
+      if file "$file" | grep -qi "text" > /dev/null 2>&1; then
+        if grep -qiEf "$PATTERNS_TMP" "$file" > /dev/null 2>&1; then
+          echo "PW-I07: BLOCKED — '$relpath' matches prohibited pattern" >&2
+          CHECKS_FAILED=1
+        fi
+      fi
+      ;;
+  esac
+}
+
+# Scan all files in evidence directory recursively
+while IFS= read -r -d '' f; do
+  sanitise_file "$f"
+done < <(find "$EVIDENCE_DIR" -type f -print0 2>/dev/null || true)
+
+if [ $CHECKS_FAILED -ne 0 ]; then
+  echo "PW-I07: SANITISATION GATE FAILED — prohibited content detected" >&2
+  exit 1
+fi
+
+echo "PW-I07: SANITISATION GATE PASSED — evidence clean" >&2
+exit 0
