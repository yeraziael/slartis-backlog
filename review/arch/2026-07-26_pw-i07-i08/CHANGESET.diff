+#!/usr/bin/env python3
+"""PW-I08 deterministic evidence bundle assembler.
+
+Usage: bundle-assemble.py <sanitised-input-dir> <bundle-dir>
+"""
+import hashlib
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+
+ALLOWED_ARTIFACT_SUFFIXES = {".png", ".zip"}
+REQUIRED_FILES = {"manifest.json", "junit.xml"}
+RETENTION_DAYS = {"pass": 7, "fail": 30, "prerequisite_error": 30, "error": 30}
+
+
+def fail(message: str) -> None:
+    print(f"PW-I08: FAIL - {message}", file=sys.stderr)
+    raise SystemExit(2)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(65536), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def main() -> None:
+    if len(sys.argv) != 3:
+        fail("USAGE: bundle-assemble.py <sanitised-input-dir> <bundle-dir>")
+
+    input_dir = Path(sys.argv[1]).resolve()
+    bundle_dir = Path(sys.argv[2]).resolve()
+    if not input_dir.is_dir():
+        fail(f"input directory not found: {input_dir}")
+
+    sanitise = Path(__file__).resolve().parents[1] / "sanitisation" / "sanitise.sh"
+    scan = subprocess.run(["bash", str(sanitise), str(input_dir)], capture_output=True, text=True)
+    if scan.returncode != 0:
+        print("PW-I08: FAIL - sanitisation gate rejected input", file=sys.stderr)
+        raise SystemExit(1)
+
+    missing = [name for name in REQUIRED_FILES if not (input_dir / name).is_file()]
+    if missing:
+        fail(f"missing required input: {', '.join(sorted(missing))}")
+
+    try:
+        manifest = json.loads((input_dir / "manifest.json").read_text())
+        result = manifest["result"]
+    except (json.JSONDecodeError, KeyError) as exc:
+        fail(f"invalid manifest: {exc}")
+    if result not in RETENTION_DAYS:
+        fail(f"unsupported result: {result}")
+
+    allowed_input = set(REQUIRED_FILES)
+    artifacts = []
+    for path in sorted(input_dir.rglob("*")):
+        if not path.is_file() or path.name in REQUIRED_FILES:
+            continue
+        if path.suffix not in ALLOWED_ARTIFACT_SUFFIXES:
+            fail(f"forbidden input file: {path.relative_to(input_dir)}")
+        artifacts.append(path)
+
+    if result == "pass" and artifacts:
+        fail("pass bundle must not include artifacts")
+    if result == "fail":
+        suffixes = {path.suffix for path in artifacts}
+        if not {".png", ".zip"}.issubset(suffixes):
+            fail("fail bundle requires both PNG screenshot and ZIP trace")
+
+    if bundle_dir.exists():
+        shutil.rmtree(bundle_dir)
+    bundle_dir.mkdir(parents=True)
+    shutil.copy2(input_dir / "manifest.json", bundle_dir / "manifest.json")
+    shutil.copy2(input_dir / "junit.xml", bundle_dir / "junit.xml")
+    for artifact in artifacts:
+        target = bundle_dir / "artifacts" / artifact.relative_to(input_dir)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(artifact, target)
+
+    inventory_files = []
+    for path in sorted(bundle_dir.rglob("*")):
+        if path.is_file():
+            inventory_files.append({
+                "path": str(path.relative_to(bundle_dir)),
+                "sha256": sha256(path),
+                "bytes": path.stat().st_size,
+            })
+    inventory = {
+        "inventory_version": 1,
+        "result": result,
+        "retention_days": RETENTION_DAYS[result],
+        "files": inventory_files,
+    }
+    (bundle_dir / "inventory.json").write_text(
+        json.dumps(inventory, indent=2, sort_keys=True) + "\n"
+    )
+    print(f"PW-I08: BUNDLE ASSEMBLED - {result}, retention {RETENTION_DAYS[result]} days", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
