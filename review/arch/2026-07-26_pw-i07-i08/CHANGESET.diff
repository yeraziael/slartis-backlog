+#!/usr/bin/env python3
+"""PW-I08 deterministic evidence bundle validator.
+
+Usage: bundle-validate.py <bundle-dir>
+"""
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+
+RETENTION_DAYS = {"pass": 7, "fail": 30, "prerequisite_error": 30, "error": 30}
+REQUIRED_FILES = {"manifest.json", "junit.xml", "inventory.json"}
+ALLOWED_ARTIFACT_SUFFIXES = {".png", ".zip"}
+
+
+def fail(message: str) -> None:
+    print(f"PW-I08: INVALID BUNDLE - {message}", file=sys.stderr)
+    raise SystemExit(1)
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(65536), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        print("PW-I08: USAGE: bundle-validate.py <bundle-dir>", file=sys.stderr)
+        raise SystemExit(2)
+
+    bundle_dir = Path(sys.argv[1]).resolve()
+    if not bundle_dir.is_dir():
+        fail(f"bundle directory not found: {bundle_dir}")
+
+    actual_files = {
+        str(path.relative_to(bundle_dir))
+        for path in bundle_dir.rglob("*") if path.is_file()
+    }
+    if not REQUIRED_FILES.issubset(actual_files):
+        fail("missing manifest.json, junit.xml, or inventory.json")
+
+    for name in actual_files - REQUIRED_FILES:
+        if not name.startswith("artifacts/") or Path(name).suffix not in ALLOWED_ARTIFACT_SUFFIXES:
+            fail(f"forbidden bundle file: {name}")
+
+    try:
+        manifest = json.loads((bundle_dir / "manifest.json").read_text())
+        inventory = json.loads((bundle_dir / "inventory.json").read_text())
+        result = manifest["result"]
+    except (json.JSONDecodeError, KeyError) as exc:
+        fail(f"invalid manifest or inventory: {exc}")
+
+    if result not in RETENTION_DAYS:
+        fail(f"unsupported result: {result}")
+    if inventory.get("result") != result:
+        fail("inventory result does not match manifest")
+    if inventory.get("retention_days") != RETENTION_DAYS[result]:
+        fail("incorrect retention class")
+
+    artifact_files = {name for name in actual_files if name.startswith("artifacts/")}
+    if result == "pass" and artifact_files:
+        fail("pass bundle contains artifacts")
+    if result == "fail":
+        suffixes = {Path(name).suffix for name in artifact_files}
+        if not {".png", ".zip"}.issubset(suffixes):
+            fail("fail bundle lacks screenshot or trace")
+
+    expected = {item.get("path"): item for item in inventory.get("files", [])}
+    checked_files = actual_files - {"inventory.json"}
+    if set(expected) != checked_files:
+        fail("inventory file list does not match bundle")
+    for name, item in expected.items():
+        path = bundle_dir / name
+        if item.get("sha256") != sha256(path) or item.get("bytes") != path.stat().st_size:
+            fail(f"checksum mismatch: {name}")
+
+    print("PW-I08: BUNDLE VALID", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
