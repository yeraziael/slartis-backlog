+# PW-I07: Prohibited patterns for evidence sanitisation gate.
+# Each line is a case-insensitive extended regex (grep -iE).
+# Lines starting with # are ignored. Empty lines are ignored.
+
+# Authorization tokens
+bearer\s+[a-zA-Z0-9_\-\.]{20,}
+authorization:\s*(basic|bearer|digest)\s
+basic\s+[a-zA-Z0-9+/=]{20,}
+
+# API keys and secrets
+api[_-]?key[=:\s]+[a-zA-Z0-9_\-]{16,}
+apikey[=:\s]+[a-zA-Z0-9_\-]{16,}
+x-api-key[=:\s]+[a-zA-Z0-9_\-]{16,}
+secret[=:\s]+[a-zA-Z0-9_\-]{16,}
+token[=:\s]+[a-zA-Z0-9_\-\.]{16,}
+
+# Session cookies
+set-cookie:\s+\S+=\S+
+connect.sid[=:\s]+\S+
+session[=:\s]+\S+
+
+# Password fields (form data, JSON, config)
+"password"\s*:\s*"[^"]+"
+password[=:\s]+\S+
+passwd[=:\s]+\S+
+
+# JWT tokens (three base64url segments)
+eyJ[a-zA-Z0-9_\-]{10,}\.[a-zA-Z0-9_\-]{10,}\.[a-zA-Z0-9_\-]{10,}
+
+# SSH private keys (header line)
+-----BEGIN\s+(RSA|DSA|EC|OPENSSH)\s+PRIVATE\s+KEY-----
+
+# Generic credential patterns in JSON/config files
+"access_token"\s*:\s*"[^"]+"
+"refresh_token"\s*:\s*"[^"]+"
+"client_secret"\s*:\s*"[^"]+"
