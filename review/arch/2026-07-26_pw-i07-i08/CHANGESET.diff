+import { test, expect } from '@playwright/test';
+import { execSync } from 'child_process';
+import * as path from 'path';
+import * as fs from 'fs';
+
+const SANITISATION_DIR = path.resolve(__dirname);
+const SANITISE_SH = path.join(SANITISATION_DIR, 'sanitise.sh');
+const FIXTURES_DIR = path.join(SANITISATION_DIR, 'fixtures');
+
+test.describe('PW-I07: sanitisation gate', () => {
+
+  test('@clean clean manifest passes sanitisation', () => {
+    const cleanDir = path.join(FIXTURES_DIR, 'clean');
+    const result = execSync(`bash "${SANITISE_SH}" "${cleanDir}"`, {
+      encoding: 'utf-8',
+    });
+    expect(result).toContain('SANITISATION GATE PASSED');
+  });
+
+  test('@leak_manifest leaky manifest is rejected', () => {
+    const leakDir = path.join(FIXTURES_DIR, 'leak');
+    const result = execSync(`bash "${SANITISE_SH}" "${leakDir}"`, {
+      encoding: 'utf-8',
+      stdio: ['pipe', 'pipe', 'pipe'],
+    }).toString();
+    expect(result).toContain('SANITISATION GATE FAILED');
+  });
+
+  test('@leak_junit leaky junit XML is rejected', () => {
+    const leakDir = path.join(FIXTURES_DIR, 'leak');
+    const result = execSync(`bash "${SANITISE_SH}" "${leakDir}"`, {
+      encoding: 'utf-8',
+    });
+    expect(result).toContain('SANITISATION GATE FAILED');
+  });
+
+  test('@leak_trace leaky trace ZIP is rejected', () => {
+    const leakDir = path.join(FIXTURES_DIR, 'leak');
+    const result = execSync(`bash "${SANITISE_SH}" "${leakDir}"`, {
+      encoding: 'utf-8',
+    });
+    expect(result).toContain('SANITISATION GATE FAILED');
+  });
+
+  test('@leak_screenshot leaky PNG is rejected', () => {
+    const leakDir = path.join(FIXTURES_DIR, 'leak');
+    const result = execSync(`bash "${SANITISE_SH}" "${leakDir}"`, {
+      encoding: 'utf-8',
+    });
+    expect(result).toContain('SANITISATION GATE FAILED');
+  });
+
+  test('@scanner_output scanner never reproduces matched values', () => {
+    const leakDir = path.join(FIXTURES_DIR, 'leak');
+    const result = execSync(`bash "${SANITISE_SH}" "${leakDir}"`, {
+      encoding: 'utf-8',
+    });
+    // Must not contain the actual synthetic leak value
+    expect(result).not.toContain('SYNTHETIC_LEAK_DO_NOT_USE_abcdefghijklmnopqrstuvwxyz');
+    expect(result).not.toContain('sup3rS3cur3P@ss!');
+  });
+
+  test('@missing_dir missing directory exits 2', () => {
+    expect(() => {
+      execSync(`bash "${SANITISE_SH}" "/nonexistent/path"`, { encoding: 'utf-8' });
+    }).toThrow();
+  });
+
+  test('@no_args missing argument exits 2', () => {
+    expect(() => {
+      execSync(`bash "${SANITISE_SH}"`, { encoding: 'utf-8' });
+    }).toThrow();
+  });
+});
