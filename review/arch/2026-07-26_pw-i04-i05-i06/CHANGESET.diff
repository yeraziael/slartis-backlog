+import { test, expect } from "@playwright/test";
+import { execSync } from "child_process";
+import * as path from "path";
+import * as fs from "fs";
+
+const PREREQ_DIR = path.resolve(__dirname, "..", "prerequisites");
+const FIXTURES_DIR = path.join(PREREQ_DIR, "fixtures");
+
+function runCheckAll(mode: string, target: string): { exitCode: number; stdout: string } {
+  const result = execSync(
+    `bash "${PREREQ_DIR}/check-all.sh" "${mode}" "${target}" 2>&1`,
+    { encoding: "utf-8", timeout: 15000 }
+  );
+  return { exitCode: 0, stdout: result };
+}
+
+function runCheckAllCapture(code: number, target: string): { exitCode: number; stdout: string } {
+  try {
+    const out = execSync(
+      `bash "${PREREQ_DIR}/check-all.sh" ${code === 0 ? "fixture" : "service"} "${target}" 2>&1`,
+      { encoding: "utf-8", timeout: 15000 }
+    );
+    return { exitCode: 0, stdout: out };
+  } catch (e: any) {
+    return { exitCode: e.status ?? 1, stdout: e.stdout ?? "" };
+  }
+}
+
+test("Check DNS resolves localhost with fixture", () => {
+  const result = execSync(
+    `bash "${PREREQ_DIR}/check-dns.sh" localhost 2>&1`,
+    { encoding: "utf-8", timeout: 10000 }
+  );
+  expect(result).toContain("PW-I05: DNS OK");
+});
+
+test("Check HTTP fixture failure returns non-zero", () => {
+  try {
+    execSync(
+      `bash "${PREREQ_DIR}/check-http.sh" http://192.0.2.1/ 2>&1`,
+      { encoding: "utf-8", timeout: 5000 }
+    );
+    // Unexpected success
+    expect(true).toBe(false);
+  } catch (e: any) {
+    expect(e.status).toBe(1);
+  }
+});
+
+test("Check-all fixture mode loads fixture.env", () => {
+  const result = execSync(
+    `bash "${PREREQ_DIR}/check-all.sh" fixture "${FIXTURES_DIR}/pass-all" 2>&1`,
+    { encoding: "utf-8", timeout: 10000 }
+  );
+  expect(result).toContain("PW-I05: PRECHECK");
+});
+
+test("Check-all missing args exits 2", () => {
+  try {
+    execSync(
+      `bash "${PREREQ_DIR}/check-all.sh" 2>&1`,
+      { encoding: "utf-8", timeout: 5000 }
+    );
+    expect(true).toBe(false);
+  } catch (e: any) {
+    expect(e.status).toBe(2);
+  }
+});
+
+test("Check scripts have usage on missing args", () => {
+  for (const script of ["check-dns.sh", "check-http.sh", "check-tls.sh", "check-keycloak.sh", "check-all.sh"]) {
+    const p = path.join(PREREQ_DIR, script);
+    expect(fs.existsSync(p)).toBe(true);
+    const content = fs.readFileSync(p, "utf-8");
+    expect(content).toContain("Usage");
+  }
+});
+
+test("Prerequisite classification spec loads without browser", () => {
+  expect(true).toBe(true);
+});
