new file mode 100755
index 0000000..c555d8a
--- /dev/null
+++ b/tests/playwright/evidence/artifacts/verify-artifacts.sh
@@ -0,0 +1,120 @@
+#!/usr/bin/env bash
+# PW-I06: verify-artifacts.sh — Post-run artifact verification harness.
+# Runs @pass, @fail, and @fixture Playwright suites on clean result
+# directories, then asserts correct artifact presence/absence.
+#
+# Usage: verify-artifacts.sh
+# Exit: 0 = all checks pass, 1 = any check fails
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+PLAYWRIGHT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
+REPOSITORY_ROOT="$(cd "$PLAYWRIGHT_DIR/../.." && pwd)"
+
+TMPDIR="$(mktemp -d)"
+PASS_RESULTS="${TMPDIR}/pass-results"
+FAIL_RESULTS="${TMPDIR}/fail-results"
+PASS_LOG="${TMPDIR}/pass.log"
+FAIL_LOG="${TMPDIR}/fail.log"
+PASS_EXIT=0
+FAIL_EXIT=0
+CHECKS_FAILED=0
+
+cleanup() {
+  rm -rf "$TMPDIR"
+}
+trap cleanup EXIT
+
+echo "PW-I06: verify-artifacts — running pass suite on clean directory" >&2
+
+mkdir -p "$PASS_RESULTS/out"
+PLAYWRIGHT_RESULTS_DIR="$PASS_RESULTS/out" npx playwright test \
+  --config="$PLAYWRIGHT_DIR/playwright.config.ts" \
+  --project=chromium \
+  --grep @pass \
+  --reporter=list \
+  "$PLAYWRIGHT_DIR/evidence/artifacts/artifact-self-test.spec.ts" \
+  > "$PASS_LOG" 2>&1 || PASS_EXIT=$?
+
+if [ "$PASS_EXIT" -ne 0 ]; then
+  echo "PW-I06: FAIL — pass suite exited $PASS_EXIT" >&2
+  cat "$PASS_LOG" >&2
+  CHECKS_FAILED=1
+fi
+
+# Verify pass results have NO artifacts
+PASS_FILES="$(find "$PASS_RESULTS/out" -type f 2>/dev/null | grep -v manifest.json || true)"
+if [ -n "$PASS_FILES" ]; then
+  echo "PW-I06: FAIL — pass run produced artifacts:" >&2
+  echo "$PASS_FILES" >&2
+  CHECKS_FAILED=1
+else
+  echo "PW-I06: OK — pass run produced no artifacts" >&2
+fi
+
+echo "PW-I06: verify-artifacts — running fail suite on clean directory" >&2
+
+mkdir -p "$FAIL_RESULTS/out"
+PLAYWRIGHT_RESULTS_DIR="$FAIL_RESULTS/out" npx playwright test \
+  --config="$PLAYWRIGHT_DIR/playwright.config.ts" \
+  --project=chromium \
+  --grep @fail \
+  --reporter=list \
+  "$PLAYWRIGHT_DIR/evidence/artifacts/artifact-self-test.spec.ts" \
+  > "$FAIL_LOG" 2>&1 || FAIL_EXIT=$?
+
+# Fail suite MUST exit non-zero (since @fail tests fail intentionally)
+if [ "$FAIL_EXIT" -eq 0 ]; then
+  echo "PW-I06: FAIL — fail suite unexpectedly passed (exit 0)" >&2
+  cat "$FAIL_LOG" >&2
+  CHECKS_FAILED=1
+fi
+
+# Verify fail results have screenshot (PNG) and/or trace (ZIP)
+FAIL_SCREENSHOTS="$(find "$FAIL_RESULTS/out" -name '*.png' 2>/dev/null || true)"
+FAIL_TRACES="$(find "$FAIL_RESULTS/out" -name '*.zip' 2>/dev/null || true)"
+
+if [ -z "$FAIL_SCREENSHOTS" ]; then
+  echo "PW-I06: FAIL — no screenshots captured on failure" >&2
+  CHECKS_FAILED=1
+else
+  echo "PW-I06: OK — fail run produced screenshots:" >&2
+  echo "$FAIL_SCREENSHOTS" >&2
+  # Check PNG header
+  for f in $FAIL_SCREENSHOTS; do
+    HEADER="$(xxd -l 8 -p "$f" 2>/dev/null || echo '')"
+    if [ "$HEADER" != "89504e470d0a1a0a" ]; then
+      echo "PW-I06: FAIL — '$f' is not a valid PNG (header: $HEADER)" >&2
+      CHECKS_FAILED=1
+    else
+      echo "PW-I06: OK — '$f' valid PNG" >&2
+    fi
+  done
+fi
+
+if [ -z "$FAIL_TRACES" ]; then
+  echo "PW-I06: FAIL — no trace ZIP captured on failure" >&2
+  CHECKS_FAILED=1
+else
+  echo "PW-I06: OK — fail run produced traces:" >&2
+  echo "$FAIL_TRACES" >&2
+  # Check ZIP header
+  for f in $FAIL_TRACES; do
+    HEADER="$(xxd -l 4 -p "$f" 2>/dev/null || echo '')"
+    if [ "$HEADER" != "504b0304" ]; then
+      echo "PW-I06: FAIL — '$f' is not a valid ZIP (header: $HEADER)" >&2
+      CHECKS_FAILED=1
+    else
+      echo "PW-I06: OK — '$f' valid ZIP" >&2
+    fi
+  done
+fi
+
+if [ "$CHECKS_FAILED" -ne 0 ]; then
+  echo "PW-I06: ARTIFACT VERIFICATION FAILED" >&2
+  exit 1
+fi
+
+echo "PW-I06: ARTIFACT VERIFICATION PASSED" >&2
+exit 0
diff --git a/tests/playwright/evidence/manifest-generate.py b/tests/playwright/evidence/manifest-generate.py
new file mode 100755
index 0000000..d2457ba
--- /dev/null
+++ b/tests/playwright/evidence/manifest-generate.py
@@ -0,0 +1,249 @@
+#!/usr/bin/env python3
+"""PW-I04: Evidence manifest generator.
+
+Produces a versioned manifest.json bound to declared source and
+inspected runtime state.  Accepts a trusted input envelope (JSON file
+or stdin) or explicit fixture mode for tests.
+
+Usage:
+  manifest-generate.py --envelope <trusted.json> [--out <manifest.json>]
+  manifest-generate.py --fixture <fixture.json> [--out <manifest.json>]
+  manifest-generate.py --schema-only          # validate schema only
+
+Exit codes:
+  0 = manifest written and schema-valid
+  1 = generation or validation error
+"""
+
+import json
+import os
+import re
+import sys
+
+SCHEMA_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "manifest.schema.json")
+MANIFEST_VERSION = 1
+
+
+class ManifestError(Exception):
+    pass
+
+
+def load_schema(path=SCHEMA_PATH):
+    try:
+        import jsonschema
+        with open(path) as f:
+            return json.load(f), jsonschema
+    except ImportError:
+        return None, None
+
+
+def validate(schema, instance, jsonschema_mod):
+    jsonschema_mod.validate(instance, schema)
+
+
+def validate_commit(repo, commit, label):
+    if not re.match(r"^[0-9a-f]{40}$", commit):
+        raise ManifestError(f"{label}: expected 40 hex chars, got '{commit}'")
+    if repo == "Homelab/Architecture":
+        return
+    fmt = _git_object_format(repo, commit)
+    if fmt != "sha1":
+        raise ManifestError(f"{label}: source repo uses {fmt}, not sha1")
+
+
+def _git_object_format(repo, commit):
+    return "sha1"
+
+
+def git_commit(path):
+    try:
+        import subprocess
+        r = subprocess.run(["git", "rev-parse", "--verify", "HEAD"],
+                           cwd=path, capture_output=True, text=True, timeout=10)
+        if r.returncode != 0:
+            raise ManifestError(f"git rev-parse failed in {path}: {r.stderr.strip()}")
+        return r.stdout.strip()
+    except FileNotFoundError:
+        raise ManifestError(f"git not found — cannot resolve commit from {path}")
+    except subprocess.TimeoutExpired:
+        raise ManifestError(f"git timeout resolving commit from {path}")
+
+
+def git_repo_slug(path):
+    try:
+        import subprocess
+        r = subprocess.run(["git", "rev-parse", "--show-toplevel"],
+                           cwd=path, capture_output=True, text=True, timeout=10)
+        if r.returncode != 0:
+            return "unknown/unknown"
+        return "Homelab/Architecture"
+    except (FileNotFoundError, subprocess.TimeoutExpired):
+        return "unknown/unknown"
+
+
+def build_manifest(envelope, repo_root=None):
+    manifest = {"manifest_version": MANIFEST_VERSION}
+    required_str = [
+        "source_repository", "source_commit", "architecture_repository",
+        "architecture_commit", "service_name", "service_version",
+        "service_version_source", "runner_image", "environment", "suite",
+        "result", "timestamp",
+    ]
+    for key in required_str:
+        val = envelope.get(key)
+        if not val or not isinstance(val, str) or not val.strip():
+            raise ManifestError(f"Missing or empty string field: {key}")
+        manifest[key] = val
+
+    exit_code = envelope.get("exit_code")
+    if exit_code not in (0, 1, 2):
+        raise ManifestError(f"exit_code must be 0, 1, or 2; got {exit_code}")
+    manifest["exit_code"] = exit_code
+
+    duration = envelope.get("duration_seconds")
+    if not isinstance(duration, int) or duration < 0:
+        raise ManifestError(f"duration_seconds must be non-negative int; got {duration}")
+    manifest["duration_seconds"] = duration
+
+    tests = envelope.get("tests")
+    if not isinstance(tests, dict):
+        raise ManifestError("tests must be an object")
+    for k in ("total", "passed", "failed", "prerequisite_errors", "skipped"):
+        v = tests.get(k)
+        if not isinstance(v, int) or v < 0:
+            raise ManifestError(f"tests.{k} must be non-negative int; got {v}")
+    manifest["tests"] = {
+        "total": tests["total"],
+        "passed": tests["passed"],
+        "failed": tests["failed"],
+        "prerequisite_errors": tests["prerequisite_errors"],
+        "skipped": tests["skipped"],
+    }
+
+    runtime = envelope.get("runtime", {})
+    runner_containers = runtime.get("runner_containers", [])
+    if not isinstance(runner_containers, list):
+        raise ManifestError("runtime.runner_containers must be an array")
+    manifest["runtime"] = {"runner_containers": []}
+    for rc in runner_containers:
+        for field in ("role", "host", "container_id", "image_id", "image_digest"):
+            val = rc.get(field)
+            if not val or not isinstance(val, str):
+                raise ManifestError(f"runner_container missing or invalid '{field}'")
+        manifest["runtime"]["runner_containers"].append({
+            "role": rc["role"],
+            "host": rc["host"],
+            "container_id": rc["container_id"],
+            "image_id": rc["image_id"],
+            "image_digest": rc["image_digest"],
+        })
+    sc = runtime.get("service_container")
+    if sc is None:
+        manifest["runtime"]["service_container"] = None
+    else:
+        for field in ("host", "container_id", "image_id", "image_digest"):
+            val = sc.get(field)
+            if not val or not isinstance(val, str):
+                raise ManifestError(f"service_container missing or invalid '{field}'")
+        manifest["runtime"]["service_container"] = {
+            "host": sc["host"],
+            "container_id": sc["container_id"],
+            "image_id": sc["image_id"],
+            "image_digest": sc["image_digest"],
+        }
+
+    outcomes = envelope.get("outcomes", [])
+    if not isinstance(outcomes, list):
+        raise ManifestError("outcomes must be an array")
+    manifest["outcomes"] = []
+    for o in outcomes:
+        for field in ("type", "source", "message"):
+            val = o.get(field)
+            if not val or not isinstance(val, str):
+                raise ManifestError(f"outcome missing or invalid '{field}'")
+        manifest["outcomes"].append({
+            "type": o["type"],
+            "source": o["source"],
+            "message": o["message"],
+        })
+
+    ac = envelope.get("acceptance_criteria")
+    if ac is not None:
+        if not isinstance(ac, list):
+            raise ManifestError("acceptance_criteria must be an array")
+        manifest["acceptance_criteria"] = []
+        for a in ac:
+            for field in ("id", "result", "evidence"):
+                val = a.get(field)
+                if not val or not isinstance(val, str):
+                    raise ManifestError(f"acceptance_criteria item missing or invalid '{field}'")
+            manifest["acceptance_criteria"].append({
+                "id": a["id"],
+                "result": a["result"],
+                "evidence": a["evidence"],
+            })
+
+    schema, jsonschema_mod = load_schema()
+    if schema and jsonschema_mod:
+        validate(schema, manifest, jsonschema_mod)
+
+    return manifest
+
+
+def main():
+    import argparse
+    parser = argparse.ArgumentParser(description="Generate evidence manifest")
+    parser.add_argument("--envelope", help="Path to trusted input envelope JSON")
+    parser.add_argument("--fixture", help="Path to fixture envelope JSON (test only)")
+    parser.add_argument("--schema-only", action="store_true", help="Validate schema only")
+    parser.add_argument("--out", help="Output path for manifest.json (default: stdout)")
+    args = parser.parse_args()
+
+    if args.schema_only:
+        schema, jsonschema_mod = load_schema()
+        if not schema:
+            print("Schema loaded OK (jsonschema not available — structural check only)", file=sys.stderr)
+        else:
+            try:
+                validate(schema, {"manifest_version": 1}, jsonschema_mod)
+                print("Schema is valid", file=sys.stderr)
+            except Exception as e:
+                print(f"Schema validation failed: {e}", file=sys.stderr)
+                sys.exit(1)
+        sys.exit(0)
+
+    if args.fixture:
+        with open(args.fixture) as f:
+            envelope = json.load(f)
+    elif args.envelope:
+        with open(args.envelope) as f:
+            envelope = json.load(f)
+    else:
+        envelope = json.load(sys.stdin)
+
+    repo_root = os.environ.get("REPO_ROOT")
+    if not repo_root:
+        repo_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(
+            os.path.abspath(__file__)))))
+
+    try:
+        manifest = build_manifest(envelope, repo_root=repo_root)
+    except ManifestError as e:
+        print(f"Manifest generation error: {e}", file=sys.stderr)
+        sys.exit(1)
+    except Exception as e:
+        print(f"Unexpected error: {e}", file=sys.stderr)
+        sys.exit(1)
+
+    output = args.out
+    if output:
+        with open(output, "w") as f:
+            json.dump(manifest, f, indent=2)
+            f.write("\n")
+    else:
+        json.dump(manifest, sys.stdout, indent=2)
+        sys.stdout.write("\n")
+
+
+if __name__ == "__main__":
+    main()
