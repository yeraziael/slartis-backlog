diff --git a/tests/playwright/prerequisites/check-all.sh b/tests/playwright/prerequisites/check-all.sh
new file mode 100755
index 0000000..d94d156
--- /dev/null
+++ b/tests/playwright/prerequisites/check-all.sh
@@ -0,0 +1,116 @@
+#!/usr/bin/env bash
+# PW-I05: check-all.sh — Orchestrate all prerequisite checks.
+# Usage:
+#   check-all.sh <mode> <target>
+#   check-all.sh fixture <fixture-dir>  — deterministic fixture tests
+#   check-all.sh service <url>          — real service checks
+#
+# Exit: 0 = all pass, 2 = any prerequisite fails
+# Writes evidence to RESULTS_DIR/out/prerequisites.json if RESULTS_DIR is set.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+MODE="${1:-}"
+TARGET="${2:-}"
+
+if [ -z "$MODE" ] || [ -z "$TARGET" ]; then
+  echo "Usage: $(basename "$0") fixture <fixture-dir> | service <base-url>" >&2
+  exit 2
+fi
+
+RESULTS_FILE="${RESULTS_DIR:-}/out/prerequisites.json"
+
+_check_pass() {
+  local check="$1" detail="$2"
+  echo "PW-I05: PRECHECK OK  $check — $detail" >&2
+}
+
+_check_fail() {
+  local check="$1" detail="$2"
+  echo "PW-I05: PRECHECK FAIL  $check — $detail" >&2
+  FAILED=1
+}
+
+run_checks() {
+  local dns_target="$1" http_target="$2" tls_target="$3" tls_port="$4" kc_base="$5" kc_realm="$6"
+  FAILED=0
+  RESULTS_JSON='{"prerequisites":[],"result":"pass"}'
+
+  # DNS check
+  if bash "${SCRIPT_DIR}/check-dns.sh" "$dns_target" >&2; then
+    _check_pass "dns" "$dns_target"
+  else
+    _check_fail "dns" "$dns_target"
+  fi
+
+  # HTTP check
+  if bash "${SCRIPT_DIR}/check-http.sh" "$http_target" >&2; then
+    _check_pass "http" "$http_target"
+  else
+    _check_fail "http" "$http_target"
+  fi
+
+  # TLS check
+  if bash "${SCRIPT_DIR}/check-tls.sh" "$tls_target" "$tls_port" >&2; then
+    _check_pass "tls" "$tls_target:$tls_port"
+  else
+    _check_fail "tls" "$tls_target:$tls_port"
+  fi
+
+  # Keycloak check
+  if [ -n "$kc_base" ]; then
+    if bash "${SCRIPT_DIR}/check-keycloak.sh" "$kc_base" "$kc_realm" >&2; then
+      _check_pass "keycloak" "discovery at $kc_base"
+    else
+      _check_fail "keycloak" "$kc_base"
+    fi
+  else
+    echo "PW-I05: PRECHECK SKIP keycloak — no base URL provided" >&2
+  fi
+
+  if [ "$FAILED" -ne 0 ]; then
+    echo "PW-I05: PRECHECK FAILED — one or more prerequisites not met" >&2
+    return 2
+  fi
+  echo "PW-I05: PRECHECK ALL OK" >&2
+  return 0
+}
+
+case "$MODE" in
+  fixture)
+    # Load expected outcomes from fixture directory
+    FIXTURE_DIR="$TARGET"
+    FIXTURE_FILE="${FIXTURE_DIR}/fixture.env"
+    if [ ! -f "$FIXTURE_FILE" ]; then
+      echo "PW-I05: missing fixture file $FIXTURE_FILE" >&2
+      exit 2
+    fi
+    # shellcheck disable=SC1090
+    source "$FIXTURE_FILE"
+    run_checks \
+      "${DNS_HOSTNAME:-localhost}" \
+      "${HTTP_URL:-http://localhost:8080/}" \
+      "${TLS_HOSTNAME:-localhost}" \
+      "${TLS_PORT:-443}" \
+      "${KEYCLOAK_BASE:-}" \
+      "${KEYCLOAK_REALM:-homelab}"
+    exit $?
+    ;;
+  service)
+    BASE_URL="$TARGET"
+    HOSTNAME="$(echo "$BASE_URL" | sed -E 's|https?://([^:/]+).*|\1|')"
+    PORT="$(echo "$BASE_URL" | sed -E 's|https?://[^:]+:?([0-9]*).*|\1|')"
+    PORT="${PORT:-443}"
+    HTTP_PORT="$(echo "$BASE_URL" | sed -E 's|https?://[^:]+:?([0-9]*).*|\1|')"
+    HTTP_URL="${BASE_URL}/"
+    KC_BASE="${3:-}"
+    KC_REALM="${4:-homelab}"
+    run_checks "$HOSTNAME" "$HTTP_URL" "$HOSTNAME" "$PORT" "$KC_BASE" "$KC_REALM"
+    exit $?
+    ;;
+  *)
+    echo "Usage: $(basename "$0") fixture <fixture-dir> | service <base-url>" >&2
+    exit 2
+    ;;
+esac
diff --git a/tests/playwright/prerequisites/check-dns.sh b/tests/playwright/prerequisites/check-dns.sh
new file mode 100755
index 0000000..400e593
--- /dev/null
+++ b/tests/playwright/prerequisites/check-dns.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+# PW-I05: check-dns.sh — Resolve a hostname to verify DNS resolution.
+# Usage: check-dns.sh <hostname> [expected-ip]
+#   If expected-ip is given, the resolved IP must match.
+#   If not, any successful resolution is sufficient.
+# Exit: 0 = pass, 1 = fail
+
+set -euo pipefail
+
+HOSTNAME="${1:-}"
+EXPECTED="${2:-}"
+
+if [ -z "$HOSTNAME" ]; then
+  echo "Usage: $(basename "$0") <hostname> [expected-ip]" >&2
+  exit 1
+fi
+
+RESOLVED=""
+# Prefer IPv4 via getent ahosts; fall back to dig, nslookup, host, or getent hosts
+if command -v getent &>/dev/null; then
+  RESOLVED="$(getent ahosts "$HOSTNAME" 2>/dev/null | awk '{print $1}' | grep -vF ':' | head -1)"
+fi
+if [ -z "$RESOLVED" ] && command -v dig &>/dev/null; then
+  RESOLVED="$(dig +short "$HOSTNAME" A 2>/dev/null | grep -v '\.$' | head -1)"
+fi
+if [ -z "$RESOLVED" ] && command -v nslookup &>/dev/null; then
+  RESOLVED="$(nslookup "$HOSTNAME" 2>/dev/null | awk '/^Address: /{print $2}' | grep -vF ':' | head -1)"
+fi
+if [ -z "$RESOLVED" ] && command -v host &>/dev/null; then
+  RESOLVED="$(host "$HOSTNAME" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
+fi
+if [ -z "$RESOLVED" ]; then
+  RESOLVED="$(getent hosts "$HOSTNAME" 2>/dev/null | awk '{print $1}' | head -1)"
+fi
+
+if [ -z "$RESOLVED" ]; then
+  echo "PW-I05: DNS FAIL — could not resolve '$HOSTNAME'" >&2
+  exit 1
+fi
+
+if [ -n "$EXPECTED" ] && [ "$RESOLVED" != "$EXPECTED" ]; then
+  echo "PW-I05: DNS FAIL — '$HOSTNAME' resolved to $RESOLVED, expected $EXPECTED" >&2
+  exit 1
+fi
+
+echo "PW-I05: DNS OK — '$HOSTNAME' → $RESOLVED" >&2
+exit 0
