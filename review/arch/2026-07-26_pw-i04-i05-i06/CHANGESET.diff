+#!/usr/bin/env bash
+# PW-I05: check-http.sh — Verify HTTP/HTTPS endpoint returns expected status.
+# Usage: check-http.sh <url> [expected-status=200]
+# Exit: 0 = pass, 1 = fail
+
+set -euo pipefail
+
+URL="${1:-}"
+EXPECTED="${2:-200}"
+
+if [ -z "$URL" ]; then
+  echo "Usage: $(basename "$0") <url> [expected-status]" >&2
+  exit 1
+fi
+
+STATUS=""
+# Prefer curl (inside container or host)
+if command -v curl &>/dev/null; then
+  STATUS="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$URL" 2>/dev/null || echo '000')"
+elif command -v wget &>/dev/null; then
+  STATUS="$(wget --spider --server-response "$URL" 2>&1 | grep 'HTTP/' | tail -1 | awk '{print $2}' || echo '000')"
+else
+  STATUS="$(node -e "
+    const http = require('$([ "${URL%%://*}" = "https" ] && echo "https" || echo "http")');
+    http.get('$URL', (r) => { console.log(r.statusCode); process.exit(0); })
+      .on('error', () => { console.log('000'); process.exit(1); });
+  " 2>/dev/null || echo '000')"
+fi
+
+if [ "$STATUS" != "$EXPECTED" ]; then
+  echo "PW-I05: HTTP FAIL — '$URL' returned $STATUS, expected $EXPECTED" >&2
+  exit 1
+fi
+
+echo "PW-I05: HTTP OK — '$URL' → $STATUS" >&2
+exit 0
