@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# PW-I04: manifest-validate.sh — Validate a manifest.json against the schema.
+# Usage: manifest-validate.sh <manifest.json>
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+SCHEMA="${SCRIPT_DIR}/manifest.schema.json"
+MANIFEST="${1:-}"
+
+if [ -z "$MANIFEST" ]; then
+  echo "Usage: $(basename "$0") <manifest.json>" >&2
+  exit 1
+fi
+
+if [ ! -f "$MANIFEST" ]; then
+  echo "ERROR: manifest file '$MANIFEST' not found" >&2
+  exit 1
+fi
+
+# Validate JSON parses
+if ! python3 -c "import json; json.load(open('$MANIFEST'))" 2>/dev/null; then
+  echo "ERROR: '$MANIFEST' is not valid JSON" >&2
+  exit 1
+fi
+
+# Schema validation
+python3 -c "
+import json, sys
+try:
+    import jsonschema
+    schema = json.load(open('$SCHEMA'))
+    manifest = json.load(open('$MANIFEST'))
+    jsonschema.validate(manifest, schema)
+    print('manifest.json: schema valid', file=sys.stderr)
+except ImportError:
+    print('manifest.json: parsed OK (jsonschema not available)', file=sys.stderr)
+except jsonschema.ValidationError as e:
+    print(f'manifest.json: INVALID — {e.message}', file=sys.stderr)
+    sys.exit(1)
+"
