@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# PW-I05: check-tls.sh — Verify TLS certificate for a host:port.
+# Usage: check-tls.sh <hostname> [port=443]
+# Exit: 0 = pass, 1 = fail
+
+set -euo pipefail
+
+HOSTNAME="${1:-}"
+PORT="${2:-443}"
+
+if [ -z "$HOSTNAME" ]; then
+  echo "Usage: $(basename "$0") <hostname> [port]" >&2
+  exit 1
+fi
+
+# Use openssl if available (inside container or host)
+if command -v openssl &>/dev/null; then
+  CERT_INFO="$(echo | openssl s_client -connect "${HOSTNAME}:${PORT}" -servername "$HOSTNAME" 2>/dev/null)"
+  EXPIRE_DATE="$(echo "$CERT_INFO" | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)"
+  SUBJECT="$(echo "$CERT_INFO" | openssl x509 -noout -subject 2>/dev/null | head -1)"
+
+  if [ -z "$EXPIRE_DATE" ]; then
+    echo "PW-I05: TLS FAIL — could not get certificate for '$HOSTNAME:$PORT'" >&2
+    exit 1
+  fi
+
+  EXPIRE_EPOCH="$(date -d "$EXPIRE_DATE" +%s 2>/dev/null || echo "0")"
+  NOW_EPOCH="$(date +%s)"
+  if [ "$EXPIRE_EPOCH" -le "$NOW_EPOCH" ]; then
+    echo "PW-I05: TLS FAIL — certificate for '$HOSTNAME' expired on $EXPIRE_DATE" >&2
+    exit 1
+  fi
+
+  DAYS_LEFT=$(( (EXPIRE_EPOCH - NOW_EPOCH) / 86400 ))
+  echo "PW-I05: TLS OK — '$HOSTNAME:$PORT' cert valid, ${DAYS_LEFT}d remaining" >&2
+  exit 0
+fi
+
+# Fallback: node.js TLS check
+node -e "
+  const tls = require('tls');
+  const socket = tls.connect($PORT, '$HOSTNAME', { servername: '$HOSTNAME' }, () => {
+    const cert = socket.getPeerCertificate();
+    const now = new Date();
+    if (new Date(cert.valid_to) <= now) {
+      console.error('PW-I05: TLS FAIL — cert expired ' + cert.valid_to);
+      process.exit(1);
+    }
+    console.error('PW-I05: TLS OK — \"$HOSTNAME\" cert valid');
+    socket.end();
+    process.exit(0);
+  });
+  socket.on('error', (e) => {
+    console.error('PW-I05: TLS FAIL — ' + e.message);
+    process.exit(1);
+  });
+" 2>&1
