+#!/usr/bin/env bash
+# PW-I05: check-keycloak.sh — Verify Keycloak OIDC discovery endpoint.
+# Usage: check-keycloak.sh <base-url> [realm=homelab]
+# Example: check-keycloak.sh https://sso.hl.maier.wtf homelab
+# Exit: 0 = pass, 1 = fail
+
+set -euo pipefail
+
+BASE_URL="${1:-}"
+REALM="${2:-homelab}"
+
+if [ -z "$BASE_URL" ]; then
+  echo "Usage: $(basename "$0") <base-url> [realm]" >&2
+  exit 1
+fi
+
+DISCOVERY_URL="${BASE_URL}/realms/${REALM}/.well-known/openid-configuration"
+
+# Use curl
+if command -v curl &>/dev/null; then
+  HTTP_STATUS="$(curl -s -o /tmp/_kc_discovery.json -w '%{http_code}' --max-time 10 "$DISCOVERY_URL" 2>/dev/null || echo '000')"
+  if [ "$HTTP_STATUS" != "200" ]; then
+    echo "PW-I05: KEYCLOAK FAIL — discovery returned HTTP $HTTP_STATUS" >&2
+    exit 1
+  fi
+  # Verify JSON has expected keys
+  python3 -c "
+import json
+try:
+    d = json.load(open('/tmp/_kc_discovery.json'))
+    for k in ['issuer', 'authorization_endpoint', 'token_endpoint', 'jwks_uri']:
+        if k not in d:
+            print(f'PW-I05: KEYCLOAK FAIL — missing {k} in OIDC discovery')
+            exit(1)
+    print('PW-I05: KEYCLOAK OK — OIDC discovery valid')
+except Exception as e:
+    print(f'PW-I05: KEYCLOAK FAIL — {e}')
+    exit(1)
+" 2>&1
+  RC=$?
+  rm -f /tmp/_kc_discovery.json
+  exit $RC
+fi
+
+echo "PW-I05: KEYCLOAK FAIL — curl not available" >&2
+exit 1
