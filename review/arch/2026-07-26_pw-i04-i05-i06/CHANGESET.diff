+import { test, expect } from "@playwright/test";
+import * as path from "path";
+
+test("Passing test completes without assertion failure", { tag: "@pass" }, async ({ page }) => {
+  await page.goto("file://" + path.resolve(__dirname, "../../platform/fixtures/local-page.html"));
+  await expect(page.locator("h1")).toHaveText("PW Self-Test");
+});
+
+test("Failing test produces screenshot and trace", { tag: "@fail" }, async ({ page }) => {
+  await page.goto("file://" + path.resolve(__dirname, "../../platform/fixtures/local-page.html"));
+  await expect(page.locator("h1")).toHaveText("nonexistent");
+});
+
+test("Prerequisite error simulation", { tag: "@prerequisite_error" }, async ({ page }) => {
+  await page.goto("file://" + path.resolve(__dirname, "../../platform/fixtures/local-page.html"));
+  const resp = await page.request.get("http://192.0.2.1/").catch(() => null);
+  expect(resp).toBeNull();
+});
