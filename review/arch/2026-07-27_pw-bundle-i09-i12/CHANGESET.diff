+#!/usr/bin/env bash
+set -euo pipefail
+
+readonly TEST_DIR="$(cd "$(dirname "$0")" && pwd)"
+readonly SCRIPT_UNDER_TEST="$TEST_DIR/../audiobookshelf/scripts/setup-playwright-identities.sh"
+
+PASS=0
+FAIL=0
+TESTS_RUN=0
+
+run_test() {
+  local name="$1"
+  shift
+  TESTS_RUN=$((TESTS_RUN + 1))
+  if "$@" >/dev/null 2>&1; then
+    echo "  PASS: $name"
+    PASS=$((PASS + 1))
+  else
+    echo "  FAIL: $name"
+    FAIL=$((FAIL + 1))
+  fi
+}
+
+test_refuses_xtrace() {
+  bash -x "$SCRIPT_UNDER_TEST" --dry-run 2>/dev/null
+  [[ $? -ne 0 ]]
+}
+
+test_dry_run_default() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  echo "$output" | grep -q "Mode: dry-run"
+}
+
+test_commit_mode() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --commit 2>&1)
+  echo "$output" | grep -q "Mode: commit"
+}
+
+test_help_flag() {
+  bash "$SCRIPT_UNDER_TEST" --help
+}
+
+test_rejects_unknown_arg() {
+  ! bash "$SCRIPT_UNDER_TEST" --invalid-flag 2>/dev/null
+}
+
+test_refuses_empty_kcadm() {
+  ! KCADM="" bash "$SCRIPT_UNDER_TEST" --dry-run 2>/dev/null
+}
+
+test_dry_run_shows_mock_marker() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  echo "$output" | grep -q "\[mock\]"
+}
+
+test_no_secret_in_output() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  ! echo "$output" | grep -qE "(password|secret|token)\s*[:=]\s*[^*]"
+}
+
+test_realms_checked_first() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  local first_mock
+  first_mock=$(echo "$output" | grep -m1 "\[mock\]")
+  echo "$first_mock" | grep -q "realms"
+}
+
+test_groups_checked() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  echo "$output" | grep -q "\[mock\].*groups"
+}
+
+test_client_checked() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  echo "$output" | grep -q "\[mock\].*clients"
+}
+
+test_all_identities_provisioned() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  echo "$output" | grep -q "pw-e2e-abs-user"
+  echo "$output" | grep -q "pw-e2e-abs-admin"
+  echo "$output" | grep -q "pw-e2e-abs-denied"
+}
+
+test_idempotent_output() {
+  local out1 out2
+  out1=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  out2=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  [[ "$out1" == "$out2" ]]
+}
+
+test_done_marker() {
+  local output
+  output=$(KCADM=/bin/true bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  echo "$output" | grep -q "done"
+}
+
+echo "=== test_playwright_identities ==="
+run_test "refuses xtrace"                      test_refuses_xtrace
+run_test "dry-run default"                     test_dry_run_default
+run_test "commit mode"                         test_commit_mode
+run_test "help flag"                           test_help_flag
+run_test "rejects unknown arg"                 test_rejects_unknown_arg
+run_test "refuses empty kcadm"                 test_refuses_empty_kcadm
+run_test "dry-run shows mock marker"           test_dry_run_shows_mock_marker
+run_test "no secret in output"                 test_no_secret_in_output
+run_test "realms checked first"                test_realms_checked_first
+run_test "groups checked"                      test_groups_checked
+run_test "client checked"                      test_client_checked
+run_test "all identities provisioned"          test_all_identities_provisioned
+run_test "done marker"                         test_done_marker
+
+echo ""
+echo "Results: $PASS/$TESTS_RUN passed, $FAIL failed"
+[[ "$FAIL" -eq 0 ]] || exit 1
