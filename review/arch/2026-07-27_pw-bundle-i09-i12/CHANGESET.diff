+import { test as base, Page, BrowserContext } from "@playwright/test";
+
+export interface OidcConfig {
+  keycloakUrl: string;
+  realm: string;
+  clientId: string;
+  absBaseUrl: string;
+}
+
+export interface OidcIdentity {
+  username: string;
+  password: string;
+}
+
+function resolveOidcConfig(): OidcConfig {
+  return {
+    keycloakUrl: process.env.KEYCLOAK_URL || "https://auth.hl.maier.wtf",
+    realm: process.env.KEYCLOAK_REALM || "homelab",
+    clientId: process.env.KEYCLOAK_CLIENT_ID || "audiobookshelf",
+    absBaseUrl: process.env.SERVICE_URL || "https://audiobookshelf.hl.maier.wtf",
+  };
+}
+
+export async function oidcLogin(
+  page: Page,
+  config: OidcConfig,
+  identity: OidcIdentity,
+): Promise<void> {
+  await page.goto(config.absBaseUrl, { waitUntil: "networkidle" });
+
+  const keycloakButton = page.getByRole("button", {
+    name: /keycloak|log in with keycloak/i,
+  });
+  const buttonCount = await keycloakButton.count();
+  if (buttonCount === 0) {
+    throw new Error(
+      "OIDC login: Keycloak SSO button not found on service page. " +
+      "The service may not be configured for OIDC or the button selector is stale.",
+    );
+  }
+  await keycloakButton.click();
+
+  await page.waitForURL(`**/realms/${config.realm}/**`, { timeout: 15_000 });
+
+  await page.fill('input[name="username"]', identity.username);
+  await page.fill('input[name="password"]', identity.password);
+  await page.getByRole("button", { name: /sign in/i }).click();
+
+  await page.waitForURL(`${config.absBaseUrl}/**`, { timeout: 15_000 });
+}
+
+export async function oidcLogout(page: Page): Promise<void> {
+  const logoutLink = page.getByRole("link", { name: /logout/i });
+  const count = await logoutLink.count();
+  if (count === 0) {
+    throw new Error(
+      "OIDC logout: no logout link found on current page. " +
+      "The session may not be authenticated or the logout UI has changed.",
+    );
+  }
+  await logoutLink.click();
+  await page.waitForURL(/logout|login/, { timeout: 10_000 });
+}
+
+export async function verifySessionInvalidated(page: Page, serviceUrl: string): Promise<void> {
+  await page.goto(serviceUrl, { waitUntil: "networkidle" });
+  const url = page.url();
+  const isUnauthenticated =
+    url.includes("/login") ||
+    url.includes("/auth/openid") ||
+    url.includes("/realms/");
+  if (!isUnauthenticated) {
+    throw new Error(
+      `Session invalidation failed: expected login/auth/openid/realms URL, got '${url}'`,
+    );
+  }
+}
+
+type OidcFixture = {
+  oidcConfig: OidcConfig;
+  oidcLogin: (page: Page, identity: OidcIdentity) => Promise<void>;
+  oidcLogout: (page: Page) => Promise<void>;
+};
+
+export const test = base.extend<OidcFixture>({
+  oidcConfig: async ({}, use) => {
+    await use(resolveOidcConfig());
+  },
+  oidcLogin: async ({}, use) => {
+    await use(async (page: Page, identity: OidcIdentity) => {
+      const config = resolveOidcConfig();
+      await oidcLogin(page, config, identity);
+    });
+  },
+  oidcLogout: async ({}, use) => {
+    await use(async (page: Page) => {
+      await oidcLogout(page);
+    });
+  },
+});
+
+export { expect };
