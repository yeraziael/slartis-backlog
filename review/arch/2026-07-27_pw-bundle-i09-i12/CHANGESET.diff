@@ -0,0 +1,352 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+readonly TEST_DIR="$(cd "$(dirname "$0")" && pwd)"
+readonly SCRIPT_UNDER_TEST="$TEST_DIR/../audiobookshelf/scripts/setup-playwright-identities.sh"
+readonly MOCK_DIR="$(mktemp -d)"
+
+PASS=0
+FAIL=0
+TESTS_RUN=0
+
+cleanup() {
+  rm -rf "$MOCK_DIR"
+}
+trap cleanup EXIT
+
+create_mock_kcadm() {
+  local call_log="$MOCK_DIR/calls.log"
+  local state_file="$MOCK_DIR/state"
+  > "$call_log"
+  > "$state_file"
+  cat > "$MOCK_DIR/kcadm" << MOCKEOF
+#!/usr/bin/env bash
+echo "\$@" >> "$call_log"
+
+REALM_EXISTS="\${REALM_EXISTS:-true}"
+GROUP_USERS_EXISTS="\${GROUP_USERS_EXISTS:-true}"
+GROUP_ADMINS_EXISTS="\${GROUP_ADMINS_EXISTS:-true}"
+CLIENT_EXISTS="\${CLIENT_EXISTS:-true}"
+EXISTING_USER="\${EXISTING_USER:-}"
+EXISTING_USER_ID="\${EXISTING_USER_ID:-}"
+STATE_FILE="$state_file"
+
+declare -A TRACKED_USERS
+if [[ -f "\$STATE_FILE" ]]; then
+  while IFS='=' read -r k v; do
+    [[ -n "\$k" ]] && TRACKED_USERS["\$k"]="\$v"
+  done < "\$STATE_FILE"
+fi
+
+track_user() { echo "\$1=\$2" >> "\$STATE_FILE"; }
+
+resolve_user() {
+  local u="\$1"
+  if [[ -n "\${TRACKED_USERS[\$u]:-}" ]]; then
+    echo "\${TRACKED_USERS[\$u]}"
+  elif [[ "\$u" == "\$EXISTING_USER" && -n "\$EXISTING_USER_ID" ]]; then
+    echo "\$EXISTING_USER_ID"
+  else
+    echo ""
+  fi
+}
+
+handle_get() {
+  local key="\$1"
+  shift
+  case "\$key" in
+    realms/homelab)
+      [[ "\$REALM_EXISTS" == "true" ]] && echo '[{"id":"test-realm-id"}]' || { echo '[]'; exit 1; }
+      ;;
+    groups)
+      local search_name=""
+      while [[ \$# -gt 0 ]]; do
+        case "\$1" in
+          -q) shift; search_name="\${1#search=}" ;;
+          search=*) search_name="\${1#search=}" ;;
+        esac
+        shift
+      done
+      if [[ "\$GROUP_USERS_EXISTS" == "true" && "\$GROUP_ADMINS_EXISTS" == "true" ]]; then
+        if [[ -n "\$search_name" ]]; then
+          case "\$search_name" in
+            *users*)     echo '[{"id":"group-users-id","name":"audiobookshelf-users"}]' ;;
+            *admins*)    echo '[{"id":"group-admins-id","name":"audiobookshelf-admins"}]' ;;
+            *)           echo '[]' ;;
+          esac
+        else
+          echo '[{"id":"group-users-id","name":"audiobookshelf-users"},{"id":"group-admins-id","name":"audiobookshelf-admins"}]'
+        fi
+      else
+        echo '[]'; exit 1
+      fi
+      ;;
+    clients)
+      [[ "\$CLIENT_EXISTS" == "true" ]] && echo '[{"clientId":"audiobookshelf"}]' || { echo '[]'; exit 1; }
+      ;;
+    users)
+      local q_user=""
+      while [[ \$# -gt 0 ]]; do
+        case "\$1" in
+          -q) shift; q_user="\${1#username=}" ;;
+          username=*) q_user="\${1#username=}" ;;
+        esac
+        shift
+      done
+      local uid
+      uid=\$(resolve_user "\$q_user")
+      if [[ -n "\$uid" ]]; then
+        echo "[{\"id\":\"\$uid\"}]"
+      else
+        echo '[]'
+      fi
+      ;;
+    groups/*/members) echo '[]' ;;
+    *) echo '[]' ;;
+  esac
+}
+
+handle_create() {
+  local new_user=""
+  for arg in "\$@"; do
+    case "\$arg" in
+      username=*) new_user="\${arg#username=}" ;;
+    esac
+  done
+  local new_id="id-\${new_user}"
+  echo "{\"id\":\"\$new_id\"}"
+  track_user "\$new_user" "\$new_id"
+}
+
+case "\$1" in
+  get) shift; handle_get "\$@" ;;
+  create) shift; handle_create "\$@" ;;
+  set-password) echo "Password set" ;;
+  update) echo "Group updated" ;;
+esac
+MOCKEOF
+  chmod +x "$MOCK_DIR/kcadm"
+}
+
+run_test() {
+  local name="$1"
+  shift
+  TESTS_RUN=$((TESTS_RUN + 1))
+  if "$@" >/dev/null 2>&1; then
+    echo "  PASS: $name"
+    PASS=$((PASS + 1))
+  else
+    echo "  FAIL: $name"
+    FAIL=$((FAIL + 1))
+  fi
+}
+
+test_refuses_xtrace() {
+  bash -x "$SCRIPT_UNDER_TEST" --dry-run 2>/dev/null
+  [[ $? -ne 0 ]]
+}
+
+test_dry_run_default() {
+  create_mock_kcadm
+  local output
+  output=$(KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --dry-run 2>&1)
+  echo "$output" | grep -q "Mode: dry-run"
+}
+
+test_commit_mode() {
+  create_mock_kcadm
+  local output
+  output=$(KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --commit 2>&1)
+  echo "$output" | grep -q "Mode: commit"
+}
+
+test_help_flag() {
+  bash "$SCRIPT_UNDER_TEST" --help
+}
+
+test_rejects_unknown_arg() {
+  ! bash "$SCRIPT_UNDER_TEST" --invalid-flag 2>/dev/null
+}
+
+test_refuses_empty_kcadm() {
+  ! KCADM="" bash "$SCRIPT_UNDER_TEST" --dry-run 2>/dev/null
+}
+
+test_dry_run_checks_realm() {
+  create_mock_kcadm
+  KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --dry-run >/dev/null 2>&1
+  grep -q "realms/homelab" "$MOCK_DIR/calls.log"
+}
+
+test_dry_run_checks_groups() {
+  create_mock_kcadm
+  KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --dry-run >/dev/null 2>&1
+  grep -q "groups" "$MOCK_DIR/calls.log"
+}
+
+test_dry_run_checks_client() {
+  create_mock_kcadm
+  KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --dry-run >/dev/null 2>&1
+  grep -q "clients" "$MOCK_DIR/calls.log"
+}
+
+test_dry_run_fails_without_realm() {
+  create_mock_kcadm
+  REALM_EXISTS="false" KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --dry-run 2>/dev/null
+  [[ $? -ne 0 ]]
+}
+
+test_dry_run_fails_without_groups() {
+  create_mock_kcadm
+  GROUP_USERS_EXISTS="false" KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --dry-run 2>/dev/null
+  [[ $? -ne 0 ]]
+}
+
+test_dry_run_fails_without_client() {
+  create_mock_kcadm
+  CLIENT_EXISTS="false" KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --dry-run 2>/dev/null
+  [[ $? -ne 0 ]]
+}
+
+test_commit_creates_user() {
+  create_mock_kcadm
+  KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --commit >/dev/null 2>&1
+  grep -q "create users" "$MOCK_DIR/calls.log"
+}
+
+test_commit_sets_password() {
+  create_mock_kcadm
+  KCADM="$MOCK_DIR/kcadm" bash "$SCRIPT_UNDER_TEST" --commit >/dev/null 2>&1
