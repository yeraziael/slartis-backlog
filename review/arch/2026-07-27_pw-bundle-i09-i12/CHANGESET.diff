+import { test as base } from "@playwright/test";
+
+export type SyntheticRole = "user" | "admin" | "denied";
+
+export interface RoleIdentity {
+  username: string;
+  password: string;
+  role: SyntheticRole;
+}
+
+const ROLE_ENV_MAP: Record<SyntheticRole, { userVar: string; passVar: string }> = {
+  user: { userVar: "PW_E2E_ABS_USER", passVar: "PW_E2E_ABS_PASSWORD" },
+  admin: { userVar: "PW_E2E_ABS_ADMIN", passVar: "PW_E2E_ABS_ADMIN_PASSWORD" },
+  denied: { userVar: "PW_E2E_ABS_DENIED", passVar: "PW_E2E_ABS_DENIED_PASSWORD" },
+};
+
+export function resolveRoleIdentity(role: SyntheticRole): RoleIdentity {
+  const env = ROLE_ENV_MAP[role];
+  const username = process.env[env.userVar];
+  const password = process.env[env.passVar];
+  if (!username || !password) {
+    throw new Error(
+      `Role '${role}' requires ${env.userVar} and ${env.passVar} to be set. ` +
+      "Run setup-playwright-identities.sh --commit first.",
+    );
+  }
+  return { username, password, role };
+}
+
+export function isRoleEnvSet(role: SyntheticRole): boolean {
+  const env = ROLE_ENV_MAP[role];
+  return !!(process.env[env.userVar] && process.env[env.passVar]);
+}
+
+type RolesFixture = {
+  userRole: SyntheticRole;
+  adminRole: SyntheticRole;
+  deniedRole: SyntheticRole;
+  resolveUser: (role: SyntheticRole) => RoleIdentity;
+};
+
+export const test = base.extend<RolesFixture>({
+  userRole: async ({}, use) => { await use("user"); },
+  adminRole: async ({}, use) => { await use("admin"); },
+  deniedRole: async ({}, use) => { await use("denied"); },
+  resolveUser: async ({}, use) => {
+    await use((role: SyntheticRole) => resolveRoleIdentity(role));
+  },
+});
+
+// test is already exported via const declaration above
