+import { test as base, Page } from "@playwright/test";
+
+export interface ConsoleEntry {
+  type: string;
+  text: string;
+  url: string;
+  lineNumber: number;
+}
+
+export interface ConsoleFilter {
+  allowPatterns?: RegExp[];
+  denyPatterns?: RegExp[];
+}
+
+const DEFAULT_ALLOW: RegExp[] = [
+  /devtools/i,
+  /favicon\.ico/i,
+  /service-worker/i,
+  /HMR/i,
+];
+
+export function createConsoleCapture(page: Page, filter?: ConsoleFilter): {
+  entries: ConsoleEntry[];
+  errors: ConsoleEntry[];
+  stop: () => void;
+} {
+  const entries: ConsoleEntry[] = [];
+  const allowPatterns = filter?.allowPatterns ?? DEFAULT_ALLOW;
+  const denyPatterns = filter?.denyPatterns ?? [];
+
+  const handler = (msg: import("@playwright/test").ConsoleMessage) => {
+    const entry: ConsoleEntry = {
+      type: msg.type(),
+      text: msg.text(),
+      url: msg.location().url,
+      lineNumber: msg.location().lineNumber,
+    };
+    entries.push(entry);
+  };
+
+  const pageHandler = (page: Page) => {
+    page.on("console", handler);
+  };
+
+  const stop = () => {
+    page.removeListener("console", handler);
+  };
+
+  page.on("console", handler);
+
+  const errors = entries.filter((e) => {
+    if (e.type !== "error" && e.type !== "warning") return false;
+    for (const allow of allowPatterns) {
+      if (allow.test(e.text) || allow.test(e.url)) return false;
+    }
+    for (const deny of denyPatterns) {
+      if (deny.test(e.text) || deny.test(e.url)) return true;
+    }
+    return e.type === "error";
+  });
+
+  return { entries, errors, stop };
+}
+
+type ConsoleFixture = {
+  consoleFilter: ConsoleFilter;
+  captureConsole: (page: Page) => ReturnType<typeof createConsoleCapture>;
+};
+
+export const test = base.extend<ConsoleFixture>({
+  consoleFilter: async ({}, use) => {
+    await use({ allowPatterns: DEFAULT_ALLOW });
+  },
+  captureConsole: async ({}, use) => {
+    await use((page: Page) => createConsoleCapture(page));
+  },
+});
+
+// test is already exported via const declaration above
