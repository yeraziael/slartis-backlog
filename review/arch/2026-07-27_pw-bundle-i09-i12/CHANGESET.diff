+import { test as base, expect, Page } from "@playwright/test";
+
+export interface FakeOidcUser {
+  username: string;
+  password: string;
+}
+
+export interface FakeOidcConfig {
+  serviceUrl: string;
+  validUsers: FakeOidcUser[];
+}
+
+function createFakeServiceHtml(): string {
+  return `<!DOCTYPE html>
+<html><head><title>Fake Service</title></head>
+<body>
+  <h1>Fake Service</h1>
+  <button id="keycloak-login" onclick="window.location.href='/auth/openid'">
+    Log in with Keycloak
+  </button>
+  <div id="content" style="display:none">
+    <p>Welcome, authenticated user</p>
+    <a href="/logout">Logout</a>
+  </div>
+  <script>
+    const params = new URLSearchParams(window.location.search);
+    if (params.has('code')) {
+      document.getElementById('keycloak-login').style.display = 'none';
+      document.getElementById('content').style.display = 'block';
+    }
+  </script>
+</body></html>`;
+}
+
+function createFakeKeycloakLoginHtml(): string {
+  return `<!DOCTYPE html>
+<html><head><title>Keycloak</title></head>
+<body>
+  <h1>Sign in to homelab</h1>
+  <form id="login-form">
+    <input name="username" placeholder="Username" />
+    <input name="password" type="password" placeholder="Password" />
+    <button type="submit">Sign In</button>
+  </form>
+  <div id="kc-error-msg" style="display:none">Invalid credentials</div>
+  <script>
+    document.getElementById('login-form').addEventListener('submit', function(e) {
+      e.preventDefault();
+      var u = document.querySelector('input[name="username"]').value;
+      var p = document.querySelector('input[name="password"]').value;
+      if (u === 'valid-user' && p === 'valid-pass') {
+        window.location.href = '/auth/openid/callback?code=fake-code-123';
+      } else {
+        document.getElementById('kc-error-msg').style.display = 'block';
+      }
+    });
+  </script>
+</body></html>`;
+}
+
+export async function setupFakeOidc(
+  page: Page,
+  config: FakeOidcConfig,
+): Promise<void> {
+  const route = page.route;
+
+  await page.route("**/auth/openid", (route) => {
+    return route.fulfill({
+      contentType: "text/html",
+      body: `<html><head><title>Keycloak</title></head>
+<body>
+  <h1>Sign in to homelab</h1>
+  <form id="login-form">
+    <input name="username" placeholder="Username" />
+    <input name="password" type="password" placeholder="Password" />
+    <button type="submit">Sign In</button>
+  </form>
+  <div class="kc-error-message" style="display:none">Invalid credentials</div>
+  <script>
+    document.getElementById('login-form').addEventListener('submit', function(e) {
+      e.preventDefault();
+      var u = document.querySelector('input[name="username"]').value;
+      var p = document.querySelector('input[name="password"]').value;
+      if (u === 'valid-user' && p === 'valid-pass') {
+        window.location.href = '/auth/openid/callback?code=fake-code-123';
+      } else {
+        document.querySelector('.kc-error-message').style.display = 'block';
+      }
+    });
+  </script>
+</body></html>`,
+    });
+  });
+
+  await page.route("**/auth/openid/callback**", (route) => {
+    return route.fulfill({
+      contentType: "text/html",
+      body: createFakeServiceHtml().replace(
+        "code=fake-code-123",
+        "code=" + new URL(route.request().url()).searchParams.get("code"),
+      ),
+    });
+  });
+
+  await page.route("**/logout", (route) => {
+    return route.fulfill({
+      contentType: "text/html",
+      body: `<html><head><title>Logged out</title></head>
+<body><h1>You have been logged out</h1><a href="/">Login</a></body></html>`,
+    });
+  });
+}
+
+type FakeOidcFixture = {
+  fakeOidcConfig: FakeOidcConfig;
+  setupFakeOidc: (page: Page, config?: Partial<FakeOidcConfig>) => Promise<void>;
+};
+
+export const test = base.extend<FakeOidcFixture>({
+  fakeOidcConfig: async ({}, use) => {
+    await use({
+      serviceUrl: "http://localhost:3000",
+      validUsers: [{ username: "valid-user", password: "***" }],
+    });
+  },
+  setupFakeOidc: async ({}, use) => {
+    await use(async (page: Page, config?: Partial<FakeOidcConfig>) => {
+      const fullConfig: FakeOidcConfig = {
+        serviceUrl: "http://localhost:3000",
+        validUsers: [{ username: "valid-user", password: "***" }],
+        ...config,
+      };
+      await setupFakeOidc(page, fullConfig);
+    });
+  },
+});
+
+export { expect };
