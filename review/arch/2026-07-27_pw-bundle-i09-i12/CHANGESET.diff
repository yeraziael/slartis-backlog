+++ b/pi/audiobookshelf/scripts/setup-playwright-identities.sh
@@ -0,0 +1,220 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+readonly SCRIPT_NAME="setup-playwright-identities"
+readonly REALM="homelab"
+readonly CLIENT_ID="audiobookshelf"
+readonly CREDENTIALS_DIR="${PW_E2E_CREDENTIALS_DIR:-$HOME/.playwright-e2e}"
+readonly CREDENTIALS_FILE="$CREDENTIALS_DIR/.credentials.json"
+
+IDENTITIES=("pw-e2e-abs-user" "pw-e2e-abs-admin" "pw-e2e-abs-denied")
+
+GROUP_USERS="audiobookshelf-users"
+GROUP_ADMINS="audiobookshelf-admins"
+
+KCADM="${KCADM:-}"
+DRY_RUN="${DRY_RUN:-true}"
+
+usage() {
+  cat <<'USAGE' >&2
+Usage: setup-playwright-identities.sh [--dry-run|--commit]
+
+Idempotent provisioning contract for synthetic Playwright identities.
+Never executed against live Keycloak from CI; always runs in dry-run
+unless the operator explicitly passes --commit in a managed runtime.
+
+Modes:
+  --dry-run   Read-only prerequisite checks; prove realm/groups/client exist
+  --commit    Provision users, rotate passwords, reconcile group membership
+
+Output (commit mode):
+  Writes structured credentials to $CREDENTIALS_FILE with mode 0600.
+  Each entry contains username and password for the provisioned identity.
+  The Playwright test runner reads this file at startup to inject
+  PW_E2E_ABS_USER / PW_E2E_ABS_PASSWORD env vars.
+
+Security:
+  * Refuses set -x (xtrace) to prevent secret leakage.
+  * Never accepts secrets via command-line arguments.
+  * Never prints existing passwords or client credentials.
+  * Requires KCADM to be set to a mocked or real kcadm binary.
+  * Credentials file is written with mode 0600 (owner-only read/write).
+USAGE
+}
+
+die() {
+  echo "ERROR: $*" >&2
+  exit 1
+}
+
+if [[ "${BASH_XTRACEFD:-}" ]] || [[ $- == *x* ]]; then
+  die "xtrace is forbidden — prevents secret leakage"
+fi
+
+case "${1:-}" in
+  --dry-run)  DRY_RUN="true" ;;
+  --commit)   DRY_RUN="false" ;;
+  --help|-h)  usage; exit 0 ;;
+  "")         ;;
+  *)          usage; exit 1 ;;
+esac
+
+[[ -n "$KCADM" ]] || die "KCADM must be set to a kcadm binary or mock"
+
+generate_password() {
+  head -c 32 /dev/urandom | base64 | tr -d '/+=' | head -c 24
+}
+
+get_user_id() {
+  local username="$1"
+  "$KCADM" get users --fields id -q username="$username" 2>/dev/null \
+    | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['id'] if d else '')" 2>/dev/null \
+    || echo ""
+}
+
+get_group_id() {
+  local group_name="$1"
+  "$KCADM" get groups --fields id -q search="$group_name" 2>/dev/null \
+    | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['id'] if d else '')" 2>/dev/null \
+    || echo ""
+}
+
+user_in_group() {
+  local user_id="$1"
+  local group_id="$2"
+  "$KCADM" get "groups/$group_id/members" --fields id -q id="$user_id" 2>/dev/null \
+    | python3 -c "import sys,json; d=json.load(sys.stdin); print('yes' if d else '')" 2>/dev/null \
+    | grep -q "yes"
+}
+
+assert_realm() {
+  echo "[$SCRIPT_NAME] Checking realm '$REALM' exists"
+  "$KCADM" get "realms/$REALM" --fields id >/dev/null 2>&1 || die "Realm $REALM not found"
+}
+
+assert_groups() {
+  for group in "$GROUP_USERS" "$GROUP_ADMINS"; do
+    echo "[$SCRIPT_NAME] Checking group '$group' exists"
+    local gid
+    gid=$(get_group_id "$group")
+    [[ -n "$gid" ]] || die "Group $group not found in realm $REALM"
+  done
+}
+
+assert_client() {
+  echo "[$SCRIPT_NAME] Checking client '$CLIENT_ID' exists"
+  "$KCADM" get clients --fields clientId -q q="$CLIENT_ID" 2>/dev/null \
+    | python3 -c "import sys,json; d=json.load(sys.stdin); exit(0 if any(c.get('clientId')=='$CLIENT_ID' for c in d) else 1)" 2>/dev/null \
+    || die "Client $CLIENT_ID not found"
+}
+
+provision_identity() {
+  local username="$1"
+  local target_group="$2"
+  local password
+  local result_var="$3"
+
+  echo "[$SCRIPT_NAME] Provisioning identity '$username'"
+  if [[ -n "$target_group" ]]; then
+    echo "  Target group: $target_group"
+  else
+    echo "  Target group: (none — denied identity)"
+  fi
+
+  local user_id=""
+  user_id=$(get_user_id "$username")
+
+  if [[ -z "$user_id" ]]; then
+    echo "  Creating user '$username'"
+    local create_output
+    create_output=$("$KCADM" create users \
+      -s username="$username" \
+      -s enabled=true \
+      -s emailVerified=true \
+      -s email="${username}@homelab.test" \
+      -s firstName="$username" \
+      -s lastName="E2E")
+    user_id=$(echo "$create_output" | python3 -c "import sys,json; print(json.load(sys.stdin).get('id',''))" 2>/dev/null || echo "")
+    if [[ -z "$user_id" ]]; then
+      user_id=$(get_user_id "$username")
+    fi
+    [[ -n "$user_id" ]] || die "Failed to create user '$username'"
+    echo "  Created user (id=$user_id)"
+  else
+    echo "  User '$username' already exists (id=$user_id)"
+  fi
+
+  password=$(generate_password)
+  echo "  Rotating password for '$username'"
+  "$KCADM" set-password --username "$username" --new-password "$password" \
+    || die "Failed to set password for '$username'"
+
+  if [[ -n "$target_group" ]]; then
+    local group_id
+    group_id=$(get_group_id "$target_group")
+    [[ -n "$group_id" ]] || die "Group '$target_group' not found"
+
+    if user_in_group "$user_id" "$group_id"; then
+      echo "  User '$username' already in group '$target_group'"
+    else
+      echo "  Adding '$username' to group '$target_group' via users/$user_id/groups/$group_id"
+      "$KCADM" update "users/$user_id/groups/$group_id" \
+        || die "Failed to add '$username' to group '$target_group'"
+    fi
+  fi
+
+  eval "$result_var"="$password"
+}
+
+write_credentials() {
+  local user_pass="$1"
+  local admin_pass="$2"
+  local denied_pass="$3"
+
+  mkdir -p "$CREDENTIALS_DIR"
+  chmod 700 "$CREDENTIALS_DIR"
+
+  python3 -c "
+import json, sys, os
+
+creds = {
+    'pw-e2e-abs-user': {'username': 'pw-e2e-abs-user', 'password': sys.argv[1]},
+    'pw-e2e-abs-admin': {'username': 'pw-e2e-abs-admin', 'password': sys.argv[2]},
+    'pw-e2e-abs-denied': {'username': 'pw-e2e-abs-denied', 'password': sys.argv[3]}
+}
+
+path = sys.argv[4]
+with open(path, 'w') as f:
+    json.dump(creds, f, indent=2)
+os.chmod(path, 0o600)
+" "$user_pass" "$admin_pass" "$denied_pass" "$CREDENTIALS_FILE"
+
+  echo "[$SCRIPT_NAME] Credentials written to $CREDENTIALS_FILE (mode 0600)"
+}
+
+main() {
+  echo "=== $SCRIPT_NAME ==="
+  echo "Mode: $(if [[ "$DRY_RUN" == "true" ]]; then echo "dry-run"; else echo "commit"; fi)"
+
+  if [[ "$DRY_RUN" == "true" ]]; then
+    assert_realm
+    assert_groups
+    assert_client
+    echo "[$SCRIPT_NAME] Prerequisite checks passed"
+  else
+    assert_realm
+    assert_groups
+    assert_client
+
+    local pw_user pw_admin pw_denied
+    provision_identity "pw-e2e-abs-user"  "$GROUP_USERS"  pw_user
+    provision_identity "pw-e2e-abs-admin"  "$GROUP_ADMINS" pw_admin
+    provision_identity "pw-e2e-abs-denied" ""             pw_denied
+
+    write_credentials "$pw_user" "$pw_admin" "$pw_denied"
+  fi
+
+  echo "=== $SCRIPT_NAME: done ==="
+}
+
+main "$@"
