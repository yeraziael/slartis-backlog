+import { Page } from "@playwright/test";
+
+export class LoginPage {
+  readonly page: Page;
+  readonly absBaseUrl: string;
+
+  constructor(page: Page, absBaseUrl?: string) {
+    this.page = page;
+    this.absBaseUrl = absBaseUrl || process.env.SERVICE_URL || "https://audiobookshelf.hl.maier.wtf";
+  }
+
+  async navigateToRoot(): Promise<void> {
+    await this.page.goto(this.absBaseUrl, { waitUntil: "networkidle" });
+  }
+
+  async hasKeycloakButton(): Promise<boolean> {
+    const button = this.page.getByRole("button", {
+      name: /keycloak|log in with keycloak/i,
+    });
+    return (await button.count()) > 0;
+  }
+
+  async getKeycloakButton() {
+    return this.page.getByRole("button", {
+      name: /keycloak|log in with keycloak/i,
+    });
+  }
+
+  async isOnLoginPage(): Promise<boolean> {
+    const url = this.page.url();
+    return url.includes("/login") || url.includes("/auth/openid");
+  }
+
+  async isOnServicePage(): Promise<boolean> {
+    const url = this.page.url();
+    return url.includes(this.absBaseUrl);
+  }
+
+  async getMainContent() {
+    return this.page.locator('[role="main"]');
+  }
+
+  async getNavigation() {
+    return this.page.locator('[role="navigation"]');
+  }
+
+  async getCurrentHref(): Promise<string> {
+    return this.page.url();
+  }
+
+  async getHttpStatus(): Promise<number | null> {
+    const response = await this.page.goto(this.absBaseUrl);
+    return response?.status() ?? null;
+  }
+}
