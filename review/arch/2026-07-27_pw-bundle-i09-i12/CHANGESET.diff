+import { test, expect } from "@playwright/test";
+import { setupFakeOidc, FakeOidcConfig } from "../fixtures/fake-oidc";
+import { oidcLogin, oidcLogout, verifySessionInvalidated } from "../fixtures/oidc";
+
+test.describe("PW-I11: Shared OIDC fixture self-test (fake harness)", () => {
+  test.describe("redirect and callback flow", () => {
+    test("navigating to service redirects to Keycloak", async ({ page }) => {
+      await setupFakeOidc(page, {});
+      await page.route("**/auth/openid", (route) => {
+        return route.fulfill({
+          contentType: "text/html",
+          body: `<html><head><title>Keycloak</title></head>
+<body>
+  <h1>Sign in</h1>
+  <form id="f"><input name="username"/><input name="password" type="password"/>
+  <button type="submit">Sign In</button></form>
+  <script>
+    document.getElementById('f').addEventListener('submit', e => {
+      e.preventDefault();
+      window.location.href = '/auth/openid/callback?code=test-code';
+    });
+  </script>
+</body></html>`,
+        });
+      });
+
+      await page.route("**/auth/openid/callback**", (route) => {
+        return route.fulfill({
+          contentType: "text/html",
+          body: `<html><body>
+          <div role="main"><p>Welcome</p></div>
+          <a href="/logout">Logout</a>
+        </body></html>`,
+        });
+      });
+
+      await page.route("http://localhost:3000/", (route) => {
+        return route.fulfill({
+          contentType: "text/html",
+          body: `<html><head><title>Fake Service</title></head>
+<body>
+  <div role="main"><p>Service Home</p></div>
+  <button onclick="window.location.href='/auth/openid'">Log in with Keycloak</button>
+</body></html>`,
+        });
+      });
+
+      await page.goto("http://localhost:3000/", { waitUntil: "networkidle" });
+      const mainVisible = await page.locator('[role="main"]').isVisible();
+      expect(mainVisible).toBeTruthy();
+    });
+
+    test("callback lands on service with code param", async ({ page }) => {
+      await setupFakeOidc(page, {});
+      await page.route("**/auth/openid/callback?code=fake-code-123", (route) => {
+        return route.fulfill({
+          contentType: "text/html",
+          body: `<html><body>
+          <div role="main"><p>Authenticated</p></div>
+          <a href="/logout">Logout</a>
+        </body></html>`,
+        });
+      });
+
+      await page.goto("http://localhost:3000/auth/openid/callback?code=fake-code-123");
+      const url = page.url();
+      expect(url).toContain("code=fake-code-123");
+      const main = page.locator('[role="main"]');
+      expect(await main.count()).toBeGreaterThan(0);
+    });
+  });
+
+  test.describe("credential handling", () => {
+    test("wrong credentials show Keycloak error", async ({ page }) => {
+      await setupFakeOidc(page, {});
+      await page.goto("http://localhost:3000/auth/openid");
+      await page.fill('input[name="username"]', "wrong-user");
+      await page.fill('input[name="password"]', "wrong-pass");
+      await page.getByRole("button", { name: /sign in/i }).click();
+      await page.waitForTimeout(300);
+      const errorVisible = await page.locator(".kc-error-message").isVisible();
+      expect(errorVisible).toBeTruthy();
+    });
+
+    test("valid credentials complete callback", async ({ page }) => {
+      await setupFakeOidc(page, {});
+      await page.goto("http://localhost:3000/auth/openid");
+      await page.fill('input[name="username"]', "valid-user");
+      await page.fill('input[name="password"]', "valid-pass");
+      await page.getByRole("button", { name: /sign in/i }).click();
+      await page.waitForURL("**/callback**", { timeout: 5_000 });
+      expect(page.url()).toContain("code=");
+    });
+  });
+
+  test.describe("logout and session cleanup", () => {
+    test("logout link redirects away from authenticated state", async ({ page }) => {
+      await setupFakeOidc(page, {});
+      await page.route("**/auth/openid/callback**", (route) => {
+        return route.fulfill({
+          contentType: "text/html",
+          body: `<html><body>
+          <div role="main"><p>Authenticated</p></div>
+          <a href="/logout">Logout</a>
+        </body></html>`,
+        });
+      });
+
+      await page.goto("http://localhost:3000/auth/openid/callback?code=test");
+      await expect(page.locator('[role="main"]')).toBeVisible();
+      await page.getByRole("link", { name: /logout/i }).click();
+      await page.waitForURL(/logout|login/, { timeout: 5_000 });
+      const url = page.url();
+      expect(url.includes("/logout") || url.includes("/login")).toBeTruthy();
+    });
+
+    test("post-logout reload stays unauthenticated", async ({ page }) => {
+      await setupFakeOidc(page, {});
+      await page.route("**/auth/openid/callback**", (route) => {
+        return route.fulfill({
+          contentType: "text/html",
+          body: `<html><body>
+          <div role="main"><p>Authenticated</p></div>
+          <a href="/logout">Logout</a>
+        </body></html>`,
+        });
+      });
+
+      await page.goto("http://localhost:3000/auth/openid/callback?code=test");
+      await page.getByRole("link", { name: /logout/i }).click();
+      await page.waitForURL(/logout|login/, { timeout: 5_000 });
+      await page.reload();
+      await page.waitForLoadState("networkidle");
+      const url = page.url();
+      expect(
+        url.includes("/login") || url.includes("/auth/openid") || url.includes("/logout"),
+      ).toBeTruthy();
+    });
+  });
+
+  test.describe("secret absence", () => {
+    test("credentials are typed into inputs, not exposed as visible text", async ({ page }) => {
+      await setupFakeOidc(page, {});
+      await page.goto("http://localhost:3000/auth/openid");
+      await page.fill('input[name="username"]', "valid-user");
+      await page.fill('input[name="password"]', "valid-pass");
+      const visibleText = await page.locator("body").innerText();
+      expect(visibleText).not.toContain("valid-pass");
+    });
+  });
+});
