+import { test as base, expect } from "@playwright/test";
+
+export interface ServiceTarget {
+  baseUrl: string;
+  serviceName: string;
+  healthPath: string;
+}
+
+export interface ServiceEnv {
+  SERVICE_URL?: string;
+  SERVICE_NAME?: string;
+  SERVICE_HEALTH_PATH?: string;
+}
+
+function parseServiceEnv(): ServiceEnv {
+  return {
+    SERVICE_URL: process.env.SERVICE_URL || undefined,
+    SERVICE_NAME: process.env.SERVICE_NAME || undefined,
+    SERVICE_HEALTH_PATH: process.env.SERVICE_HEALTH_PATH || undefined,
+  };
+}
+
+export function resolveServiceTarget(overrides?: Partial<ServiceTarget>): ServiceTarget {
+  const env = parseServiceEnv();
+  const baseUrl = overrides?.baseUrl || env.SERVICE_URL;
+  if (!baseUrl) {
+    throw new Error(
+      "SERVICE_URL must be set or service target must be provided. " +
+      "Set SERVICE_URL or pass a target to the fixture.",
+    );
+  }
+  return {
+    baseUrl: baseUrl.replace(/\/$/, ""),
+    serviceName: overrides?.serviceName || env.SERVICE_NAME || "unknown",
+    healthPath: overrides?.healthPath || env.SERVICE_HEALTH_PATH || "/",
+  };
+}
+
+export async function checkServiceHealth(target: ServiceTarget): Promise<{ ok: boolean; status?: number }> {
+  try {
+    const response = await fetch(`${target.baseUrl}${target.healthPath}`);
+    return { ok: response.ok, status: response.status };
+  } catch {
+    return { ok: false };
+  }
+}
+
+type ServiceFixture = {
+  serviceTarget: ServiceTarget;
+  serviceHealth: { ok: boolean; status?: number };
+};
+
+export const test = base.extend<ServiceFixture>({
+  serviceTarget: async ({}, use) => {
+    const target = resolveServiceTarget();
+    await use(target);
+  },
+  serviceHealth: async ({ serviceTarget }, use) => {
+    const health = await checkServiceHealth(serviceTarget);
+    await use(health);
+  },
+});
+
+export { expect };
