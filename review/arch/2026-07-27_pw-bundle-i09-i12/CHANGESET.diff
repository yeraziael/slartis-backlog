+import { test, expect } from "@playwright/test";
+import { LoginPage } from "./pages/login";
+
+test.describe("PW-I12: Audiobookshelf unauthenticated smoke", () => {
+  let login: LoginPage;
+
+  test.beforeEach(async ({ page }) => {
+    login = new LoginPage(page);
+  });
+
+  test("HTTPS endpoint is reachable", async () => {
+    const status = await login.getHttpStatus();
+    expect(status).toBeGreaterThanOrEqual(200);
+    expect(status).toBeLessThan(400);
+  });
+
+  test("page loads without console errors", async ({ page }) => {
+    const errors: string[] = [];
+    page.on("console", (msg) => {
+      if (msg.type() === "error") {
+        const text = msg.text();
+        if (!/devtools|favicon|service-worker/i.test(text)) {
+          errors.push(text);
+        }
+      }
+    });
+
+    await login.navigateToRoot();
+    await page.waitForLoadState("networkidle");
+    expect(errors).toHaveLength(0);
+  });
+
+  test("login page or service home is rendered", async ({ page }) => {
+    await login.navigateToRoot();
+    const url = page.url();
+    const isRendered =
+      url.includes("/login") ||
+      url.includes("/auth/openid") ||
+      url.includes("audiobookshelf");
+    expect(isRendered).toBeTruthy();
+  });
+
+  test("Keycloak SSO button is present (if on login page)", async ({ page }) => {
+    await login.navigateToRoot();
+    const url = page.url();
+    if (url.includes("/login") || url.includes("/auth/openid")) {
+      const hasButton = await login.hasKeycloakButton();
+      expect(hasButton).toBeTruthy();
+    }
+  });
+
+  test("page title or main content area exists", async ({ page }) => {
+    await login.navigateToRoot();
+    await page.waitForLoadState("networkidle");
+    const title = await page.title();
+    const hasMain = (await login.getMainContent().then((m) => m.count())) > 0;
+    expect(title.length > 0 || hasMain).toBeTruthy();
+  });
+});
