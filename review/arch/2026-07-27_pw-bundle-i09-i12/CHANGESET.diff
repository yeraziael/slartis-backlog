+import { test, expect } from "@playwright/test";
+import {
+  resolveServiceTarget,
+  checkServiceHealth,
+} from "../fixtures/service";
+import {
+  resolveRoleIdentity,
+  isRoleEnvSet,
+  SyntheticRole,
+} from "../fixtures/roles";
+import {
+  createConsoleCapture,
+  ConsoleEntry,
+} from "../fixtures/console";
+
+test.describe("PW-I10: Shared fixtures self-test", () => {
+  test.describe("service fixture", () => {
+    test("throws when SERVICE_URL is missing", () => {
+      const original = process.env.SERVICE_URL;
+      delete process.env.SERVICE_URL;
+      try {
+        expect(() => resolveServiceTarget()).toThrow(/SERVICE_URL must be set/);
+      } finally {
+        if (original !== undefined) process.env.SERVICE_URL = original;
+      }
+    });
+
+    test("resolves target from env", () => {
+      const original = process.env.SERVICE_URL;
+      process.env.SERVICE_URL = "https://example.test";
+      try {
+        const target = resolveServiceTarget();
+        expect(target.baseUrl).toBe("https://example.test");
+        expect(target.serviceName).toBe("unknown");
+        expect(target.healthPath).toBe("/");
+      } finally {
+        if (original !== undefined) process.env.SERVICE_URL = original;
+        else delete process.env.SERVICE_URL;
+      }
+    });
+
+    test("resolves target with overrides", () => {
+      const target = resolveServiceTarget({
+        baseUrl: "https://custom.test",
+        serviceName: "testsvc",
+        healthPath: "/health",
+      });
+      expect(target.baseUrl).toBe("https://custom.test");
+      expect(target.serviceName).toBe("testsvc");
+      expect(target.healthPath).toBe("/health");
+    });
+
+    test("strips trailing slash from baseUrl", () => {
+      const target = resolveServiceTarget({ baseUrl: "https://example.test/" });
+      expect(target.baseUrl).toBe("https://example.test");
+    });
+  });
+
+  test.describe("roles fixture", () => {
+    test("throws when role env vars are missing", () => {
+      const savedUser = process.env.PW_E2E_ABS_USER;
+      const savedPass = process.env.PW_E2E_ABS_PASSWORD;
+      delete process.env.PW_E2E_ABS_USER;
+      delete process.env.PW_E2E_ABS_PASSWORD;
+      try {
+        expect(() => resolveRoleIdentity("user")).toThrow(/requires.*PW_E2E_ABS_USER/);
+      } finally {
+        if (savedUser !== undefined) process.env.PW_E2E_ABS_USER = savedUser;
+        if (savedPass !== undefined) process.env.PW_E2E_ABS_PASSWORD = savedPass;
+      }
+    });
+
+    test("resolves identity when env vars are set", () => {
+      const savedUser = process.env.PW_E2E_ABS_USER;
+      const savedPass = process.env.PW_E2E_ABS_PASSWORD;
+      process.env.PW_E2E_ABS_USER = "test-user";
+      process.env.PW_E2E_ABS_PASSWORD = "***";
+      try {
+        const identity = resolveRoleIdentity("user");
+        expect(identity.username).toBe("test-user");
+        expect(identity.password).toBe("test-pass");
+        expect(identity.role).toBe("user");
+      } finally {
+        if (savedUser !== undefined) process.env.PW_E2E_ABS_USER = savedUser;
+        else delete process.env.PW_E2E_ABS_USER;
+        if (savedPass !== undefined) process.env.PW_E2E_ABS_PASSWORD = savedPass;
+        else delete process.env.PW_E2E_ABS_PASSWORD;
+      }
+    });
+
+    test("isRoleEnvSet returns false when vars missing", () => {
+      const saved = process.env.PW_E2E_ABS_USER;
+      delete process.env.PW_E2E_ABS_USER;
+      try {
+        expect(isRoleEnvSet("user")).toBe(false);
+      } finally {
+        if (saved !== undefined) process.env.PW_E2E_ABS_USER = saved;
+      }
+    });
+  });
+
+  test.describe("console fixture", () => {
+    test("captures console entries", async ({ page }) => {
+      const capture = createConsoleCapture(page);
+      await page.goto("data:text/html,<script>console.log('test-entry')</script>");
+      await page.waitForTimeout(200);
+      expect(capture.entries.length).toBeGreaterThan(0);
+      expect(capture.entries.some((e) => e.text.includes("test-entry"))).toBeTruthy();
+      capture.stop();
+    });
+
+    test("filters known allowlist patterns", async ({ page }) => {
+      const capture = createConsoleCapture(page);
+      await page.goto("data:text/html,<script>console.log('devtools check')</script>");
+      await page.waitForTimeout(200);
+      const filtered = capture.entries.filter((e) => {
+        const allowPatterns = [/devtools/i];
+        for (const allow of allowPatterns) {
+          if (allow.test(e.text)) return false;
+        }
+        return true;
+      });
+      expect(filtered.some((e) => e.text.includes("devtools"))).toBe(false);
+      capture.stop();
+    });
+
+    test("entries have required fields", async ({ page }) => {
+      const capture = createConsoleCapture(page);
+      await page.goto("data:text/html,<script>console.warn('field-test')</script>");
+      await page.waitForTimeout(200);
+      const entry = capture.entries.find((e) => e.text.includes("field-test"));
+      expect(entry).toBeDefined();
+      expect(entry!.type).toBeTruthy();
+      expect(entry!.text).toBeTruthy();
+      capture.stop();
+    });
+  });
+});
