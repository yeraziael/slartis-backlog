@@ -0,0 +1,69 @@
+# Playwright Headed POC
+
+This POC runs Chromium in headed mode on Xvfb and exposes the virtual display
+through password-protected VNC. The default command cycles through these public
+Homelab HTTPS FQDNs, leaves each page visible for ten seconds, and completes
+ten full rounds:
+
+- `https://auth.hl.maier.wtf/`
+- `https://audiobookshelf.hl.maier.wtf/`
+- `https://cwa.hl.maier.wtf/`
+- `https://element.hl.maier.wtf/`
+- `https://gitea.hl.maier.wtf/`
+- `https://gitea-mcp.hl.maier.wtf/`
+- `https://matrix.hl.maier.wtf/`
+- `https://pprls.hl.maier.wtf/`
+- `https://pprlsf.hl.maier.wtf/`
+
+## Start
+
+From the repository root:
+
+```bash
+bash tools/playwright-headed/run.sh
+```
+
+The runner builds the pinned image when necessary, starts the container in the
+background, waits until the VNC TCP port accepts connections, and sends the
+connection details to the configured Telegram chat. It also prints the same
+details locally.
+
+Connect with a VNC client to the printed `vnc://` address. Stop the repeating
+task with:
+
+```bash
+docker stop playwright-headed-poc
+```
+
+Follow the browser task log with:
+
+```bash
+docker logs -f playwright-headed-poc
+```
+
+## Configuration
+
+- `VNC_ADVERTISE_HOST` - host shown in the VNC address; defaults to `192.168.2.211`
+- `VNC_BIND_IP` - host address to which Docker binds VNC; defaults to `192.168.2.211`
+- `VNC_HOST_PORT` - fixed host port; otherwise the first free port from 5900-5999
+- `VNC_PASSWORD` - password; otherwise an eight-character random password is generated
+- `DISPLAY_SECONDS` - display duration; defaults to `10`
+- `ENDPOINT_ROUNDS` - number of complete rounds; defaults to `10`
+- `PUBLIC_ENDPOINTS` - optional whitespace-separated HTTPS FQDN override
+- `TELEGRAM_TOKEN_FILE` - token path; defaults to `~/.creds/telegram_slarti.token`
+- `TELEGRAM_CHAT_ID` - destination chat; defaults to `163442721`
+- `FORCE_BUILD=true` - rebuild the image even when the tag already exists
+
+The Telegram token and VNC password are runtime inputs only and are not stored
+in the repository.
+
+## Headless Counterpart
+
+For CI and non-interactive platform tests, use the separate headless runner:
+
+```bash
+make test-playwright-platform
+```
+
+The headless runner is the standard test path. This directory adds only the
+operator-observable Xvfb/VNC path and does not replace the headless CI contract.
diff --git a/tools/playwright-headed/entrypoint.sh b/tools/playwright-headed/entrypoint.sh
new file mode 100755
index 0000000..d22e1e1
--- /dev/null
+++ b/tools/playwright-headed/entrypoint.sh
@@ -0,0 +1,92 @@
+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+DISPLAY="${DISPLAY:-:99}"
+VNC_ENABLED="${VNC_ENABLED:-true}"
+VNC_PORT="${VNC_PORT:-5900}"
+XVFB_SCREEN="${XVFB_SCREEN:-1920x1080x24}"
+
+XVFB_PID=""
+VNC_PID=""
+CHILD_PID=""
+PASSWORD_FILE=""
+
+cleanup() {
+    local status=$?
+    trap - EXIT INT TERM
+
+    if [[ -n "${VNC_PID}" ]] && kill -0 "${VNC_PID}" 2>/dev/null; then
+        kill "${VNC_PID}" 2>/dev/null || true
+        wait "${VNC_PID}" 2>/dev/null || true
+    fi
+    if [[ -n "${XVFB_PID}" ]] && kill -0 "${XVFB_PID}" 2>/dev/null; then
+        kill "${XVFB_PID}" 2>/dev/null || true
+        wait "${XVFB_PID}" 2>/dev/null || true
+    fi
+    if [[ -n "${PASSWORD_FILE}" ]]; then
+        rm -f "${PASSWORD_FILE}"
+    fi
+    exit "${status}"
+}
+
+forward_signal() {
+    if [[ -n "${CHILD_PID}" ]] && kill -0 "${CHILD_PID}" 2>/dev/null; then
+        kill -TERM "${CHILD_PID}" 2>/dev/null || true
+    fi
+}
+
+trap cleanup EXIT
+trap forward_signal INT TERM
+
+Xvfb "${DISPLAY}" -screen 0 "${XVFB_SCREEN}" -nolisten tcp &
+XVFB_PID=$!
+
+DISPLAY_NUMBER="${DISPLAY#:}"
+for _ in $(seq 1 20); do
+    if [[ -S "/tmp/.X11-unix/X${DISPLAY_NUMBER}" ]]; then
+        break
+    fi
+    if ! kill -0 "${XVFB_PID}" 2>/dev/null; then
+        echo "Xvfb exited before the display became ready" >&2
+        exit 1
+    fi
+    sleep 0.1
+done
+
+if [[ ! -S "/tmp/.X11-unix/X${DISPLAY_NUMBER}" ]]; then
+    echo "Display ${DISPLAY} did not become ready" >&2
+    exit 1
+fi
+
+if [[ "${VNC_ENABLED}" == "true" ]]; then
+    if [[ -z "${VNC_PASSWORD:-}" ]]; then
+        echo "VNC_PASSWORD is required when VNC_ENABLED=true" >&2
+        exit 2
+    fi
+
+    PASSWORD_FILE="$(mktemp)"
+    chmod 600 "${PASSWORD_FILE}"
+    printf '%s\n' "${VNC_PASSWORD}" > "${PASSWORD_FILE}"
+    x11vnc \
+        -display "${DISPLAY}" \
+        -rfbport "${VNC_PORT}" \
+        -passwdfile "${PASSWORD_FILE}" \
+        -forever \
+        -shared \
+        -noxdamage \
+        -quiet &
+    VNC_PID=$!
+fi
+
+if [[ "$#" -eq 0 ]]; then
+    echo "No container command supplied" >&2
+    exit 2
+fi
+
+"$@" &
+CHILD_PID=$!
+set +e
+wait "${CHILD_PID}"
+CHILD_STATUS=$?
+set -e
+exit "${CHILD_STATUS}"
