new file mode 100644
index 0000000..17579e4
--- /dev/null
+++ b/tests/playwright/automation/repeat-endpoints.mjs
@@ -0,0 +1,153 @@
+import { chromium } from "playwright";
+
+const DEFAULT_ENDPOINTS = [
+  "https://auth.hl.maier.wtf/",
+  "https://audiobookshelf.hl.maier.wtf/",
+  "https://cwa.hl.maier.wtf/",
+  "https://element.hl.maier.wtf/",
+  "https://gitea.hl.maier.wtf/",
+  "https://gitea-mcp.hl.maier.wtf/",
+  "https://matrix.hl.maier.wtf/",
+  "https://pprls.hl.maier.wtf/",
+  "https://pprlsf.hl.maier.wtf/",
+];
+
+const DISPLAY_SECONDS = Number.parseInt(
+  process.env.DISPLAY_SECONDS ?? "10",
+  10,
+);
+const ROUNDS = Number.parseInt(process.env.ENDPOINT_ROUNDS ?? "10", 10);
+const DISPLAY_MS = DISPLAY_SECONDS * 1000;
+const NAVIGATION_TIMEOUT_MS = Math.min(
+  8_000,
+  Math.max(1_000, DISPLAY_MS - 500),
+);
+const ENDPOINTS = (process.env.PUBLIC_ENDPOINTS ?? DEFAULT_ENDPOINTS.join("\n"))
+  .split(/\s+/)
+  .filter(Boolean)
+  .map((endpoint) => {
+    const url = new URL(endpoint);
+    if (url.protocol !== "https:" || !url.hostname.endsWith(".hl.maier.wtf")) {
+      throw new Error(`Endpoint is not a public Homelab HTTPS FQDN: ${endpoint}`);
+    }
+    return url.toString();
+  });
+
+if (!Number.isInteger(DISPLAY_SECONDS) || DISPLAY_SECONDS < 1) {
+  throw new Error("DISPLAY_SECONDS must be a positive integer");
+}
+if (!Number.isInteger(ROUNDS) || ROUNDS < 1) {
+  throw new Error("ENDPOINT_ROUNDS must be a positive integer");
+}
+if (ENDPOINTS.length === 0) {
+  throw new Error("PUBLIC_ENDPOINTS must contain at least one endpoint");
+}
+
+let stopping = false;
+let resolveStop;
+const stopRequested = new Promise((resolve) => {
+  resolveStop = resolve;
+});
+
+function requestStop(signal) {
+  if (stopping) {
+    return;
+  }
+  stopping = true;
+  console.log(`Stop signal ${signal} received; closing the browser.`);
+  resolveStop();
+}
+
+process.once("SIGTERM", () => requestStop("SIGTERM"));
+process.once("SIGINT", () => requestStop("SIGINT"));
+
+function escapeHtml(value) {
+  return value.replace(
+    /[&<>'"]/g,
+    (character) =>
+      ({
+        "&": "&amp;",
+        "<": "&lt;",
+        ">": "&gt;",
+        "'": "&#39;",
+        '"': "&quot;",
+      })[character],
+  );
+}
+
+async function waitForSlot(milliseconds) {
+  if (milliseconds <= 0) {
+    return;
+  }
+  await Promise.race([
+    new Promise((resolve) => setTimeout(resolve, milliseconds)),
+    stopRequested,
+  ]);
+}
+
+async function showEndpoint(context, page, endpoint, round, index) {
+  const slotStartedAt = Date.now();
+  console.log(
+    `Round ${round}/${ROUNDS}, endpoint ${index + 1}/${ENDPOINTS.length}: ${endpoint}`,
+  );
+
+  try {
+    await page.goto(endpoint, {
+      waitUntil: "domcontentloaded",
+      timeout: NAVIGATION_TIMEOUT_MS,
+    });
+    console.log(`Loaded ${await page.title()}`);
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    console.error(`Endpoint failed: ${message}`);
+    const errorPage = `
+      <main style="font: 24px sans-serif; padding: 4rem">
+        <h1>Endpoint unavailable</h1>
+        <p>${escapeHtml(endpoint)}</p>
+        <pre>${escapeHtml(message)}</pre>
+      </main>
+    `;
+    try {
+      await page.close();
+      page = await context.newPage();
+      await page.setContent(errorPage);
+    } catch (renderError) {
+      console.error(`Could not render endpoint error page: ${renderError.message}`);
+    }
+  }
+
+  const remainingMs = DISPLAY_MS - (Date.now() - slotStartedAt);
+  await waitForSlot(remainingMs);
+  return page;
+}
+
+async function main() {
+  const browser = await chromium.launch({
+    headless: false,
+    args: ["--no-sandbox"],
+  });
+  const context = await browser.newContext({
+    locale: "de-DE",
+    viewport: { width: 1920, height: 1080 },
+  });
+  let page = await context.newPage();
+
+  try {
+    for (let round = 1; round <= ROUNDS && !stopping; round += 1) {
+      for (let index = 0; index < ENDPOINTS.length && !stopping; index += 1) {
+        page = await showEndpoint(context, page, ENDPOINTS[index], round, index);
+      }
+    }
+    if (!stopping) {
+      console.log(`Completed ${ROUNDS} endpoint rounds.`);
+    }
+  } finally {
+    await browser.close();
+    console.log("Playwright endpoint loop stopped.");
+  }
+}
+
+main().catch((error) => {
+  console.error(error);
+  process.exitCode = 1;
+});
