@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Contract tests for the observable, repeating Playwright POC runner."""
+
+from pathlib import Path
+import subprocess
+
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+TOOL_DIR = REPO_ROOT / "tools" / "playwright-headed"
+RUNNER = TOOL_DIR / "run.sh"
+ENDPOINT_LOOP = REPO_ROOT / "tests" / "playwright" / "automation" / "repeat-endpoints.mjs"
+ENTRYPOINT = TOOL_DIR / "entrypoint.sh"
+README = TOOL_DIR / "README.md"
+PLATFORM_README = REPO_ROOT / "tests" / "playwright" / "README.md"
+ROOT_README = REPO_ROOT / "README.md"
+
+
+def read(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def test_headed_image_contains_display_and_vnc_services():
+    dockerfile = read(TOOL_DIR / "Dockerfile")
+
+    assert "xvfb" in dockerfile
+    assert "x11vnc" in dockerfile
+    assert "EXPOSE 5900" in dockerfile
+
+
+def test_entrypoint_starts_virtual_display_and_forwards_signals():
+    entrypoint = read(ENTRYPOINT)
+
+    assert "Xvfb \"${DISPLAY}\"" in entrypoint
+    assert "x11vnc" in entrypoint
+    assert "VNC_ENABLED" in entrypoint
+    assert 'kill -TERM "${CHILD_PID}"' in entrypoint
+
+
+def test_endpoint_loop_contains_public_fqdns_and_round_contract():
+    endpoint_loop = read(ENDPOINT_LOOP)
+
+    for endpoint in (
+        "https://auth.hl.maier.wtf/",
+        "https://audiobookshelf.hl.maier.wtf/",
+        "https://cwa.hl.maier.wtf/",
+        "https://element.hl.maier.wtf/",
+        "https://gitea.hl.maier.wtf/",
+        "https://gitea-mcp.hl.maier.wtf/",
+        "https://matrix.hl.maier.wtf/",
+        "https://pprls.hl.maier.wtf/",
+        "https://pprlsf.hl.maier.wtf/",
+    ):
+        assert endpoint in endpoint_loop
+
+    assert "ENDPOINT_ROUNDS" in endpoint_loop
+    assert "for (let round = 1; round <= ROUNDS" in endpoint_loop
+    assert "waitForSlot" in endpoint_loop
+    assert 'process.once("SIGTERM"' in endpoint_loop
+    assert 'process.once("SIGINT"' in endpoint_loop
+    assert "headless: false" in endpoint_loop
+
+
+def test_runner_waits_for_vnc_and_notifies_telegram():
+    runner = read(RUNNER)
+
+    assert "docker run -d" in runner
+    assert "--name \"${CONTAINER_NAME}\"" in runner
+    assert "nc -z" in runner
+    assert "api.telegram.org/bot" in runner
+    assert "sendMessage" in runner
+    assert "VNC_HOST_PORT" in runner
+    assert "repeat-endpoints.mjs" in runner
+
+
+def test_runner_is_shellcheckable_and_documented():
+    result = subprocess.run(
+        ["bash", "-n", str(RUNNER), str(ENTRYPOINT)],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+
+    assert result.returncode == 0, result.stderr
+    documentation = read(README)
+    assert "docker stop playwright-headed-poc" in documentation
+    assert "Telegram" in documentation
+
+
+def test_documentation_describes_headless_and_vnc_modes():
+    platform_documentation = read(PLATFORM_README)
+    root_documentation = read(ROOT_README)
+
+    assert "make test-playwright-platform" in platform_documentation
+    assert "bash tools/playwright-headed/run.sh" in platform_documentation
+    assert "headless" in platform_documentation.lower()
+    assert "VNC" in platform_documentation
+    assert "tests/playwright/README.md" in root_documentation
+    assert "tools/playwright-headed/README.md" in root_documentation
+
+
+if __name__ == "__main__":
+    tests = [
+        test_headed_image_contains_display_and_vnc_services,
+        test_entrypoint_starts_virtual_display_and_forwards_signals,
+        test_endpoint_loop_contains_public_fqdns_and_round_contract,
+        test_runner_waits_for_vnc_and_notifies_telegram,
+        test_runner_is_shellcheckable_and_documented,
+        test_documentation_describes_headless_and_vnc_modes,
+    ]
+    failures = 0
+    for test in tests:
+        try:
+            test()
+            print(f"  PASS  {test.__name__}")
+        except Exception as error:  # noqa: BLE001 - keep the standalone harness simple
+            print(f"  FAIL  {test.__name__}: {error}")
+            failures += 1
+    if failures:
+        raise SystemExit(failures)
+    print(f"headed Playwright contract tests: ALL {len(tests)} PASS")
