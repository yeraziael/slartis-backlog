+RUN apt-get update && apt-get install -y --no-install-recommends \
+    xvfb \
+    x11vnc \
+    && rm -rf /var/lib/apt/lists/*
+
+WORKDIR /opt/playwright
+COPY tests/playwright/package.json tests/playwright/package-lock.json ./
+RUN npm ci --ignore-scripts --no-audit --no-fund
+COPY tests/playwright/automation/repeat-endpoints.mjs ./repeat-endpoints.mjs
