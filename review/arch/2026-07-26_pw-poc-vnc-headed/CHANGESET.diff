+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+IMAGE_NAME="homelab/playwright-headed"
+IMAGE_TAG="v1.61.1-noble-poc"
+FULL_IMAGE="${IMAGE_NAME}:${IMAGE_TAG}"
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+REPOSITORY_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
+RESULTS_DIR="${REPOSITORY_ROOT}/test-results/playwright-headed"
+
+CONTAINER_NAME="${PLAYWRIGHT_CONTAINER_NAME:-playwright-headed-poc}"
+VNC_ADVERTISE_HOST="${VNC_ADVERTISE_HOST:-192.168.2.211}"
+VNC_BIND_IP="${VNC_BIND_IP:-192.168.2.211}"
+VNC_CHECK_HOST="${VNC_CHECK_HOST:-${VNC_ADVERTISE_HOST}}"
+VNC_HOST_PORT="${VNC_HOST_PORT:-}"
+if [[ -z "${VNC_PASSWORD:-}" ]]; then
+    printf -v VNC_PASSWORD '%s' "$(openssl rand -hex 4)"
+fi
+DISPLAY_SECONDS="${DISPLAY_SECONDS:-10}"
+ENDPOINT_ROUNDS="${ENDPOINT_ROUNDS:-10}"
+TELEGRAM_TOKEN_FILE="${TELEGRAM_TOKEN_FILE:-${HOME}/.creds/telegram_slarti.token}"
+TELEGRAM_CHAT_ID="${TELEGRAM_CHAT_ID:-163442721}"
+
+die() {
+    echo "ERROR: $*" >&2
+    exit 1
+}
+
+build_image() {
+    if [[ "${FORCE_BUILD:-false}" != "true" ]] && docker image inspect "${FULL_IMAGE}" >/dev/null 2>&1; then
+        echo "Image ${FULL_IMAGE} existiert bereits"
+        return 0
+    fi
+    echo "Baue Image ${FULL_IMAGE} ..."
+    docker build -f "${SCRIPT_DIR}/Dockerfile" -t "${FULL_IMAGE}" "${REPOSITORY_ROOT}"
+}
+
+pick_port() {
+    local port listeners
+    for port in $(seq 5900 5999); do
+        listeners="$(ss -H -ltn "sport = :${port}" 2>/dev/null || true)"
+        if [[ -z "${listeners}" ]]; then
+            echo "${port}"
+            return 0
+        fi
+    done
+    die "Kein freier VNC-Port zwischen 5900 und 5999"
+}
+
+wait_for_vnc() {
+    local attempt state
+    for attempt in $(seq 1 30); do
+        if nc -z -w 1 "${VNC_CHECK_HOST}" "${VNC_HOST_PORT}" 2>/dev/null; then
+            return 0
+        fi
+        state="$(docker inspect --format '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null || true)"
+        if [[ "${state}" != "true" ]]; then
+            echo "Container ist vor VNC-Readiness beendet:" >&2
+            docker logs --tail 40 "${CONTAINER_NAME}" 2>&1 || true
+            return 1
+        fi
+        sleep 1
+    done
+    echo "VNC-Port ${VNC_CHECK_HOST}:${VNC_HOST_PORT} wurde nach ${attempt} Versuchen nicht bereit" >&2
+    docker logs --tail 40 "${CONTAINER_NAME}" 2>&1 || true
+    return 1
+}
+
+send_telegram() {
+    local message="$1" token response_file
+    if [[ ! -r "${TELEGRAM_TOKEN_FILE}" ]]; then
+        echo "WARN: Telegram-Token nicht lesbar: ${TELEGRAM_TOKEN_FILE}" >&2
+        return 0
+    fi
+    IFS= read -r token < "${TELEGRAM_TOKEN_FILE}" || true
+    if [[ -z "${token}" ]]; then
+        echo "WARN: Telegram-Token ist leer" >&2
+        return 0
+    fi
+    if ! command -v curl >/dev/null 2>&1; then
+        echo "WARN: curl fehlt; Telegram-Benachrichtigung uebersprungen" >&2
+        return 0
+    fi
+
+    response_file="$(mktemp)"
+    if ! curl --fail --silent --show-error --max-time 15 \
+        --url "https://api.telegram.org/bot${token}/sendMessage" \
+        --data-urlencode "chat_id=${TELEGRAM_CHAT_ID}" \
+        --data-urlencode "text=${message}" \
+        > "${response_file}"; then
+        echo "WARN: Telegram-Benachrichtigung konnte nicht gesendet werden" >&2
+    fi
+    rm -f "${response_file}"
+}
+
+command -v docker >/dev/null 2>&1 || die "docker fehlt"
+command -v nc >/dev/null 2>&1 || die "nc fehlt"
+command -v openssl >/dev/null 2>&1 || die "openssl fehlt"
+
+if docker container inspect "${CONTAINER_NAME}" >/dev/null 2>&1; then
+    die "Container ${CONTAINER_NAME} existiert bereits; zuerst docker stop ${CONTAINER_NAME} ausfuehren"
+fi
+
+if [[ -z "${VNC_HOST_PORT}" ]]; then
+    VNC_HOST_PORT="$(pick_port)"
+fi
+[[ "${VNC_HOST_PORT}" =~ ^[0-9]+$ ]] || die "VNC_HOST_PORT muss numerisch sein"
+
+mkdir -p "${RESULTS_DIR}"
+build_image
+
+ENV_FILE="$(mktemp)"
+chmod 600 "${ENV_FILE}"
+trap 'rm -f "${ENV_FILE}"' EXIT
+printf 'VNC_PASSWORD=%s\n' "${VNC_PASSWORD}" > "${ENV_FILE}"
+
+if [[ "$#" -eq 0 ]]; then
+    CONTAINER_COMMAND=(
+        node
+        /opt/playwright/repeat-endpoints.mjs
+    )
+else
+    CONTAINER_COMMAND=("$@")
+fi
+
+CONTAINER_ID="$(docker run -d --rm \
+    --name "${CONTAINER_NAME}" \
+    --init \
+    --shm-size=2g \
+    --platform linux/amd64 \
+    --network bridge \
+    --cap-drop ALL \
+    --security-opt no-new-privileges:true \
+    --tmpfs /tmp:rw,nosuid,nodev,size=512m,mode=1777 \
+    --mount "type=bind,src=${REPOSITORY_ROOT},dst=/workspace,readonly" \
+    --mount "type=bind,src=${RESULTS_DIR},dst=/results" \
+    --publish "${VNC_BIND_IP}:${VNC_HOST_PORT}:5900" \
+    --env-file "${ENV_FILE}" \
+    --env DISPLAY=:99 \
+    --env VNC_ENABLED=true \
+    --env VNC_PORT=5900 \
+    --env PLAYWRIGHT_HEADLESS=false \
+    --env DISPLAY_SECONDS="${DISPLAY_SECONDS}" \
+    --env ENDPOINT_ROUNDS="${ENDPOINT_ROUNDS}" \
+    --env PLAYWRIGHT_RESULTS_DIR=/results/out \
+    --workdir /workspace \
+    "${FULL_IMAGE}" \
+    "${CONTAINER_COMMAND[@]}")" || die "Container konnte nicht gestartet werden"
+
+if ! wait_for_vnc; then
+    docker stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
+    exit 1
+fi
+
+CONNECTION_MESSAGE="$(printf '%s\n%s\n%s\n%s\n%s\n%s' \
+    'Playwright Headed ist bereit.' \
+    "VNC: vnc://${VNC_ADVERTISE_HOST}:${VNC_HOST_PORT}" \
+    "Passwort: ${VNC_PASSWORD}" \
+    "Container: ${CONTAINER_NAME}" \
+    "Stoppen: docker stop ${CONTAINER_NAME}" \
+    "Der Endpoint-Loop zeigt jeden oeffentlichen FQDN ${DISPLAY_SECONDS} Sekunden und beendet sich nach ${ENDPOINT_ROUNDS} Runden.")"
+
+echo ""
+echo "${CONNECTION_MESSAGE}"
+echo "Container-ID: ${CONTAINER_ID}"
+echo "Logs: docker logs -f ${CONTAINER_NAME}"
+send_telegram "${CONNECTION_MESSAGE}"
