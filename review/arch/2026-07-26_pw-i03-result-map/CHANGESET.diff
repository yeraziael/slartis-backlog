diff --git a/tests/playwright/runner/map-result.sh b/tests/playwright/runner/map-result.sh
new file mode 100755
index 0000000..f2d28e8
--- /dev/null
+++ b/tests/playwright/runner/map-result.sh
@@ -0,0 +1,49 @@
+#!/usr/bin/env bash
+# PW-I03: map-result.sh — Map phase exit code to PW-D02 result precedence
+# Usage: map-result.sh <exit-code> <phase>
+# Phase: dependency, test
+# Output exit codes: 0=pass, 1=fail/error, 2=prerequisite_error
+
+set -euo pipefail
+
+EXIT_CODE="${1:-}"
+PHASE="${2:-}"
+
+if [ -z "$EXIT_CODE" ] || [ -z "$PHASE" ]; then
+  echo "Usage: map-result.sh <exit-code> <phase>" >&2
+  exit 1
+fi
+
+# Docker infrastructure errors: exit codes 125+ (docker daemon, container start)
+is_docker_error() {
+  [ "$1" -ge 125 ]
+}
+
+case "$PHASE" in
+  dependency)
+    if is_docker_error "$EXIT_CODE"; then
+      echo "PW-I03: error — Docker infrastructure failure (exit $EXIT_CODE)" >&2
+      exit 1
+    fi
+    if [ "$EXIT_CODE" -ne 0 ]; then
+      echo "PW-I03: prerequisite_error — dependency phase failed (exit $EXIT_CODE)" >&2
+      exit 2
+    fi
+    exit 0
+    ;;
+  test)
+    if is_docker_error "$EXIT_CODE"; then
+      echo "PW-I03: error — Docker infrastructure failure (exit $EXIT_CODE)" >&2
+      exit 1
+    fi
+    if [ "$EXIT_CODE" -ne 0 ]; then
+      echo "PW-I03: fail — test failure (exit $EXIT_CODE)" >&2
+      exit 1
+    fi
+    exit 0
+    ;;
+  *)
+    echo "map-result: unknown phase '$PHASE'" >&2
+    exit 1
+    ;;
+esac
