+import { Page } from "@playwright/test";
+
+export class LibraryPage {
+  readonly page: Page;
+  readonly mainSelector = '[role="main"]';
+  readonly navSelector = '[role="navigation"]';
+  readonly libraryListSelector = '[data-testid="library-list"], ul[aria-label="Library"]';
+
+  constructor(page: Page) {
+    this.page = page;
+  }
+
+  async waitForLoad(): Promise<void> {
+    await this.page.waitForSelector(this.mainSelector, { timeout: 15_000 });
+  }
+
+  async hasLibraryList(): Promise<boolean> {
+    const count = await this.page.locator(this.libraryListSelector).count();
+    return count > 0;
+  }
+
+  async hasNavLink(label: string): Promise<boolean> {
+    const link = this.page.getByRole("link", { name: label });
+    return (await link.count()) > 0;
+  }
+
+  async isLoginPage(): Promise<boolean> {
+    const url = this.page.url();
+    return url.includes("/login") || url.includes("/auth/openid");
+  }
+
+  async getCurrentHref(): Promise<string> {
+    return this.page.url();
+  }
+
+  async hasNoMediaItems(): Promise<boolean> {
+    const items = this.page.locator('[data-testid="audiobook"], [data-testid="media"]');
+    return (await items.count()) === 0;
+  }
+}
