@@ -0,0 +1,116 @@
+import { test, expect } from "@playwright/test";
+import { OidcPage } from "./pages/oidc.page";
+import { LibraryPage } from "./pages/library.page";
+
+const ABS_BASE = "https://audiobookshelf.hl.maier.wtf";
+
+function requireCredentials(): { username: string; password: string } {
+  const username = process.env.PW_E2E_ABS_USER;
+  const password = process.env.PW_E2E_ABS_PASSWORD;
+  if (!username || !password) {
+    throw new Error(
+      "PW_E2E_ABS_USER and PW_E2E_ABS_PASSWORD must be set " +
+      "for authenticated smoke tests. Skipping.",
+    );
+  }
+  return { username, password };
+}
+
+test.describe("PW-I13: Audiobookshelf authenticated login and logout smoke", () => {
+  let oidc: OidcPage;
+  let library: LibraryPage;
+
+  test.beforeEach(async ({ page }) => {
+    oidc = new OidcPage(page);
+    library = new LibraryPage(page);
+  });
+
+  test("login success redirects to library landing", async ({ page }) => {
+    const { username, password } = requireCredentials();
+
+    await oidc.navigateToLogin();
+    await oidc.clickKeycloakLogin();
+    await oidc.fillKeycloakCredentials(username, password);
+    await oidc.waitForAbsLanding();
+
+    await library.waitForLoad();
+    const url = page.url();
+    expect(url).not.toContain("/login");
+    expect(url).not.toContain("/auth/openid");
+  });
+
+  test("invalid credentials stays on Keycloak login with error", async ({ page }) => {
+    await oidc.navigateToLogin();
+    await oidc.clickKeycloakLogin();
+
+    await page.waitForURL("**/realms/homelab/**", { timeout: 10_000 });
+
+    await oidc.fillKeycloakCredentials("nonexistent-user-pw-i13", "definitely-wrong-password");
+
+    await page.waitForLoadState("networkidle");
+
+    const hasError = await oidc.isKeycloakErrorVisible();
+    const stillOnKeycloak = page.url().includes("/realms/homelab");
+
+    expect(hasError || stillOnKeycloak).toBeTruthy();
+  });
+
+  test("logout terminates local session and redirects", async ({ page }) => {
+    const { username, password } = requireCredentials();
+
+    await oidc.navigateToLogin();
+    await oidc.clickKeycloakLogin();
+    await oidc.fillKeycloakCredentials(username, password);
+    await oidc.waitForAbsLanding();
+    await library.waitForLoad();
+
+    await oidc.performRpInitiatedLogout();
+
+    await page.waitForURL(/logout|login/, { timeout: 10_000 });
+    const url = page.url();
+    expect(
+      url.includes("/login") || url.includes("/logout"),
+    ).toBeTruthy();
+  });
+
+  test("post-logout reload remains unauthenticated", async ({ page }) => {
+    const { username, password } = requireCredentials();
+
+    await oidc.navigateToLogin();
+    await oidc.clickKeycloakLogin();
+    await oidc.fillKeycloakCredentials(username, password);
+    await oidc.waitForAbsLanding();
+    await library.waitForLoad();
+
+    await oidc.performRpInitiatedLogout();
+    await page.waitForURL(/logout|login/, { timeout: 10_000 });
+
+    await page.reload();
+    await page.waitForLoadState("networkidle");
+
+    const url = page.url();
+    expect(
+      url.includes("/login") || url.includes("/auth/openid"),
+    ).toBeTruthy();
+  });
+
+  test("revisit protected route after logout requires re-authentication", async ({ page }) => {
+    const { username, password } = requireCredentials();
+
+    await oidc.navigateToLogin();
+    await oidc.clickKeycloakLogin();
+    await oidc.fillKeycloakCredentials(username, password);
+    await oidc.waitForAbsLanding();
+    await library.waitForLoad();
+
+    await oidc.performRpInitiatedLogout();
+    await page.waitForURL(/logout|login/, { timeout: 10_000 });
+
+    await page.goto(ABS_BASE, { waitUntil: "networkidle" });
+
+    const url = page.url();
+    expect(
+      url.includes("/login") || url.includes("/auth/openid") || url.includes("/realms/"),
+    ).toBeTruthy();
+  });
+});
