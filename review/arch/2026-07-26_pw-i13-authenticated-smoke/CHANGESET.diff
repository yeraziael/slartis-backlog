+import { Page } from "@playwright/test";
+
+export class OidcPage {
+  readonly page: Page;
+  readonly loginUrl: string;
+  readonly logoutUrl: string;
+  readonly callbackUrl: string;
+
+  constructor(page: Page) {
+    this.page = page;
+    this.loginUrl = "https://audiobookshelf.hl.maier.wtf/";
+    this.logoutUrl =
+      "https://auth.hl.maier.wtf/realms/homelab/protocol/openid-connect/logout";
+    this.callbackUrl = "https://audiobookshelf.hl.maier.wtf/auth/openid/callback";
+  }
+
+  async navigateToLogin(): Promise<void> {
+    await this.page.goto(this.loginUrl, { waitUntil: "networkidle" });
+  }
+
+  async clickKeycloakLogin(): Promise<void> {
+    const keycloakButton = this.page.getByRole("button", {
+      name: /keycloak|log in with keycloak/i,
+    });
+    await keycloakButton.click();
+  }
+
+  async fillKeycloakCredentials(username: string, password: string): Promise<void> {
+    await this.page.fill('input[name="username"]', username);
+    await this.page.fill('input[name="password"]', password);
+    await this.page.getByRole("button", { name: /sign in/i }).click();
+  }
+
+  async waitForCallback(): Promise<void> {
+    await this.page.waitForURL(this.callbackUrl, { timeout: 15_000 });
+  }
+
+  async redirectToLogout(): Promise<void> {
+    await this.page.goto(this.logoutUrl, { waitUntil: "networkidle" });
+  }
+
+  async performRpInitiatedLogout(): Promise<void> {
+    const logoutLink = this.page.getByRole("link", { name: /logout/i });
+    if ((await logoutLink.count()) > 0) {
+      await logoutLink.click();
+      await this.page.waitForURL(/logout|login/, { timeout: 10_000 });
+    }
+  }
+}
