+#!/usr/bin/env python3
+"""Deterministic conformance tests for the ACP post-publication audit."""
+
+import copy
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+import yaml
+
+
+REPO = Path(__file__).resolve().parent.parent
+FIXTURES = Path(__file__).resolve().parent / "fixtures" / "release-audit"
+MODULE_PATH = Path(__file__).resolve().parent / "release_audit.py"
+SPEC = importlib.util.spec_from_file_location("release_audit", MODULE_PATH)
+release_audit = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(release_audit)
+
+
+class FakeGiteaClient:
+    def __init__(self, release, blobs):
+        self.release = release
+        self.blobs = blobs
+
+    def get_release(self, tag):
+        if self.release and self.release.get("tag_name") == tag:
+            return copy.deepcopy(self.release)
+        return copy.deepcopy(self.release)
+
+    def download_asset(self, asset):
+        return self.blobs[asset["browser_download_url"]]
+
+
+def git(repo, *args, env=None):
+    result = subprocess.run(
+        ["git", *args], cwd=repo, env=env, text=True,
+        capture_output=True, check=False,
+    )
+    if result.returncode:
+        raise AssertionError(result.stderr)
+    return result.stdout.strip()
+
+
+def replace_placeholders(value, replacements):
+    if isinstance(value, dict):
+        return {key: replace_placeholders(item, replacements)
+                for key, item in value.items()}
+    if isinstance(value, list):
+        return [replace_placeholders(item, replacements) for item in value]
+    if isinstance(value, str):
+        for marker, replacement in replacements.items():
+            value = value.replace(marker, replacement)
+    return value
+
+
+class ReleaseAuditTests(unittest.TestCase):
+    def build_fixture(self):
+        tmp = tempfile.TemporaryDirectory()
+        repo = Path(tmp.name)
+        git(repo, "init", "-q")
+        git(repo, "config", "user.name", "ACP Test")
+        git(repo, "config", "user.email", "acp@example.test")
+
+        evidence = repo / "releases" / "v1.2.3" / "release-evidence.yaml"
+        evidence.parent.mkdir(parents=True)
+        evidence.write_text(
+            "evidence_model_version: 2\n"
+            "repository: Homelab/ACP\n"
+            "proposed_version: 1.2.3\n"
+            "proposed_tag: v1.2.3\n",
+            encoding="utf-8",
+        )
+        git(repo, "add", ".")
+        commit_env = os.environ.copy()
+        commit_env.update({
+            "GIT_AUTHOR_DATE": "2029-12-31T23:59:57Z",
+            "GIT_COMMITTER_DATE": "2029-12-31T23:59:57Z",
+        })
+        git(repo, "commit", "-q", "-m", "release preparation", env=commit_env)
+        peeled = git(repo, "rev-parse", "HEAD")
+
+        tag_env = os.environ.copy()
+        tag_env["GIT_COMMITTER_DATE"] = "2029-12-31T23:59:58Z"
+        git(repo, "tag", "-a", "v1.2.3", "-m", "ACP v1.2.3", env=tag_env)
+        tag_object = git(repo, "rev-parse", "v1.2.3^{object}")
+
+        release = json.loads(
+            (FIXTURES / "release-valid.json").read_text(encoding="utf-8")
+        )
+        artifact = b"deterministic ACP artifact\n"
+        notes = release["body"].encode("utf-8")
+        replacements = {
+            "${TAG_OBJECT}": tag_object,
+            "${PEELED_COMMIT}": peeled,
+            "${RELEASE_NOTES_HASH}": hashlib.sha256(notes).hexdigest(),
+            "${ARTIFACT_HASH}": hashlib.sha256(artifact).hexdigest(),
+        }
+        release = replace_placeholders(release, replacements)
+        attestation_text = replace_placeholders(
+            (FIXTURES / "attestation-valid.yaml").read_text(encoding="utf-8"),
+            replacements,
+        )
+        blobs = {
+            "memory://artifact.tar.gz": artifact,
+            "memory://release-attestation.yaml": attestation_text.encode("utf-8"),
+        }
+        return tmp, repo, release, blobs
+
+    def codes(self, repo, release, blobs):
+        findings = release_audit.audit_repository(
+            repo, "Homelab/ACP", FakeGiteaClient(release, blobs)
+        )
+        return {finding["code"] for finding in findings}
+
+    def mutate_attestation(self, blobs, mutator):
+        data = yaml.safe_load(blobs["memory://release-attestation.yaml"])
+        mutator(data)
+        blobs["memory://release-attestation.yaml"] = yaml.safe_dump(
+            data, sort_keys=False
+        ).encode("utf-8")
+
+    def test_valid_release_binding_passes(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        self.assertEqual(set(), self.codes(repo, release, blobs))
+
+    def test_missing_release_is_rejected(self):
+        tmp, repo, _, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        self.assertIn("RELEASE_MISSING", self.codes(repo, None, blobs))
+
+    def test_release_referring_to_another_tag_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        release["tag_name"] = "v1.2.4"
+        self.assertIn("RELEASE_TAG_MISMATCH", self.codes(repo, release, blobs))
+
+    def test_missing_or_empty_release_notes_are_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        release["body"] = "   \n"
+        self.assertIn("RELEASE_NOTES_EMPTY", self.codes(repo, release, blobs))
+
+    def test_release_target_drift_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        release["target_commitish"] = "f" * 40
+        self.assertIn("RELEASE_TARGET_MISMATCH", self.codes(repo, release, blobs))
+
+    def test_attestation_peeled_commit_drift_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        self.mutate_attestation(
+            blobs,
+            lambda data: data.update({"peeled_target_commit_id": "f" * 40}),
+        )
+        self.assertIn("ATTESTATION_PEELED_COMMIT_MISMATCH",
+                      self.codes(repo, release, blobs))
+
+    def test_release_notes_hash_mismatch_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        self.mutate_attestation(
+            blobs, lambda data: data.update({"release_notes_hash": "f" * 64})
+        )
+        self.assertIn("RELEASE_NOTES_HASH_MISMATCH",
+                      self.codes(repo, release, blobs))
+
+    def test_wrong_evidence_model_version_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        self.mutate_attestation(
+            blobs,
+            lambda data: data.update({"evidence_model_version": 1}),
+        )
+        self.assertIn("ATTESTATION_MODEL_VERSION_MISMATCH",
+                      self.codes(repo, release, blobs))
+
+    def test_asset_hash_mismatch_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        blobs["memory://artifact.tar.gz"] = b"drifted artifact\n"
+        self.assertIn("ASSET_HASH_MISMATCH", self.codes(repo, release, blobs))
+
+    def test_missing_pre_publication_evidence_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        self.mutate_attestation(
+            blobs,
+            lambda data: data.update({
+                "pre_publication_evidence_path":
+                    "releases/v1.2.3/missing-evidence.yaml"
+            }),
+        )
+        self.assertIn("PREPUBLICATION_EVIDENCE_MISSING",
+                      self.codes(repo, release, blobs))
+
+    def test_attestation_self_reference_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+
+        def add_self_reference(data):
+            data["assets"].append({
+                "name": "release-attestation.yaml",
+                "sha256": "f" * 64,
+            })
+
+        self.mutate_attestation(blobs, add_self_reference)
+        self.assertIn("ATTESTATION_SELF_REFERENCE",
+                      self.codes(repo, release, blobs))
+
+    def test_attestation_created_before_release_is_rejected(self):
+        tmp, repo, release, blobs = self.build_fixture()
+        self.addCleanup(tmp.cleanup)
+        self.mutate_attestation(
+            blobs,
+            lambda data: data.update({
+                "creation_timestamp": "2029-12-31T23:59:59Z"
+            }),
+        )
+        self.assertIn("ATTESTATION_CREATED_TOO_EARLY",
+                      self.codes(repo, release, blobs))
+
+    def test_no_stable_tags_is_not_a_failure(self):
+        with tempfile.TemporaryDirectory() as td:
+            repo = Path(td)
+            git(repo, "init", "-q")
+            findings = release_audit.audit_repository(
+                repo, "Homelab/ACP", FakeGiteaClient(None, {})
+            )
+            self.assertEqual([], findings)
+
+
+if __name__ == "__main__":
+    unittest.main()
