+++ b/CONFORMANCE/release_audit.py
@@ -0,0 +1,436 @@
+#!/usr/bin/env python3
+"""Verify stable ACP tags against Gitea releases and release attestations."""
+
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+from urllib import error, parse, request
+
+import yaml
+
+
+STABLE_TAG = re.compile(r"^v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$")
+FULL_SHA1 = re.compile(r"^[0-9a-f]{40}$")
+FULL_SHA256 = re.compile(r"^[0-9a-f]{64}$")
+ATTESTATION_ASSET = "release-attestation.yaml"
+REQUIRED_ATTESTATION_FIELDS = (
+    "evidence_model_version",
+    "repository",
+    "release_version",
+    "annotated_tag_name",
+    "annotated_tag_object_id",
+    "peeled_target_commit_id",
+    "hosting_platform",
+    "hosting_platform_release_reference",
+    "release_notes_hash",
+    "assets",
+    "ci_run_reference",
+    "pre_publication_evidence_path",
+    "pre_publication_evidence_commit",
+    "creation_timestamp",
+)
+
+
+class AuditError(Exception):
+    """Raised when the audit cannot safely execute."""
+
+
+def finding(code, tag, message):
+    return {"code": code, "tag": tag, "message": message}
+
+
+def run_git(repo_root, *args, check=True):
+    result = subprocess.run(
+        ["git", *args], cwd=repo_root, text=True,
+        capture_output=True, check=False,
+    )
+    if check and result.returncode:
+        raise AuditError(
+            f"git {' '.join(args)} failed: {result.stderr.strip()}"
+        )
+    return result
+
+
+def stable_tags(repo_root):
+    output = run_git(
+        repo_root,
+        "for-each-ref",
+        "--format=%(refname:short)%09%(objecttype)%09%(objectname)%09%(*objectname)%09%(creatordate:iso-strict)",
+        "refs/tags",
+    ).stdout
+    tags = []
+    for line in output.splitlines():
+        name, object_type, object_id, peeled, created_at = line.split("\t", 4)
+        if STABLE_TAG.fullmatch(name):
+            tags.append({
+                "name": name,
+                "object_type": object_type,
+                "object_id": object_id,
+                "peeled_commit": peeled or object_id,
+                "created_at": created_at,
+            })
+    return tags
+
+
+def parse_timestamp(value):
+    if isinstance(value, datetime):
+        timestamp = value
+    else:
+        text = str(value).strip().replace("Z", "+00:00")
+        timestamp = datetime.fromisoformat(text)
+    if timestamp.tzinfo is None:
+        timestamp = timestamp.replace(tzinfo=timezone.utc)
+    return timestamp
+
+
+def git_path_exists(repo_root, commit, path):
+    if not FULL_SHA1.fullmatch(str(commit)):
+        return False
+    result = run_git(repo_root, "cat-file", "-e", f"{commit}:{path}", check=False)
+    return result.returncode == 0
+
+
+class GiteaClient:
+    """Minimal read-only Gitea client used by the post-publication audit."""
+
+    def __init__(self, api_url, repository, token):
+        if not token:
+            raise AuditError("Gitea audit token is empty")
+        self.api_url = api_url.rstrip("/")
+        self.repository = "/".join(
+            parse.quote(part, safe="") for part in repository.split("/", 1)
+        )
+        self.token = token
+
+    def _open(self, url):
+        req = request.Request(
+            url,
+            headers={
+                "Authorization": f"token {self.token}",
+                "Accept": "application/json",
+            },
+        )
+        try:
+            return request.urlopen(req, timeout=30)
+        except error.HTTPError as exc:
+            if exc.code == 404:
+                return None
+            raise AuditError(f"Gitea request failed with HTTP {exc.code}") from exc
+        except error.URLError as exc:
+            raise AuditError(f"Gitea request failed: {exc.reason}") from exc
+
+    def get_release(self, tag):
+        encoded_tag = parse.quote(tag, safe="")
+        response = self._open(
+            f"{self.api_url}/repos/{self.repository}/releases/tags/{encoded_tag}"
+        )
+        if response is None:
+            return None
+        with response:
+            return json.load(response)
+
+    def download_asset(self, asset):
+        url = asset.get("browser_download_url") or asset.get("url")
+        if not url:
+            raise AuditError(f"Release asset {asset.get('name')} has no download URL")
+        response = self._open(url)
+        if response is None:
+            raise AuditError(f"Release asset {asset.get('name')} returned HTTP 404")
+        with response:
+            return response.read()
+
+
+def load_attestation(client, release, tag):
+    matches = [
+        asset for asset in (release.get("assets") or [])
+        if asset.get("name") == ATTESTATION_ASSET
+    ]
+    if len(matches) != 1:
+        return None, finding(
+            "ATTESTATION_ASSET_COUNT", tag,
+            "Release must contain exactly one release-attestation.yaml asset",
+        )
+    try:
+        document = yaml.safe_load(client.download_asset(matches[0]))
+    except (AuditError, UnicodeDecodeError, yaml.YAMLError) as exc:
+        return None, finding(
+            "ATTESTATION_INVALID", tag,
+            f"Cannot load release attestation: {exc}",
+        )
+    if not isinstance(document, dict):
+        return None, finding(
+            "ATTESTATION_INVALID", tag,
+            "Release attestation must be a YAML mapping",
+        )
+    return document, None
+
+
+def audit_attestation(repo_root, repository, client, tag_record,
+                      release, attestation):
+    tag = tag_record["name"]
+    findings = []
+    missing = [
+        field for field in REQUIRED_ATTESTATION_FIELDS
+        if field not in attestation or attestation[field] is None
+    ]
+    if missing:
+        findings.append(finding(
+            "ATTESTATION_FIELDS_MISSING", tag,
+            f"Missing required attestation fields: {', '.join(missing)}",
+        ))
+        return findings
+
+    if attestation.get("evidence_model_version") != 2:
+        findings.append(finding(
+            "ATTESTATION_MODEL_VERSION_MISMATCH", tag,
+            "evidence_model_version must be 2",
+        ))
+    if not isinstance(attestation.get("ci_run_reference"), str) or not (
+            attestation["ci_run_reference"].strip()):
+        findings.append(finding(
+            "CI_RUN_REFERENCE_INVALID", tag,
+            "ci_run_reference must identify a durable CI record",
+        ))
+
+    expected_version = tag.removeprefix("v")
+    bindings = (
+        ("repository", repository, "ATTESTATION_REPOSITORY_MISMATCH"),
+        ("release_version", expected_version, "ATTESTATION_VERSION_MISMATCH"),
+        ("annotated_tag_name", tag, "ATTESTATION_TAG_MISMATCH"),
+        ("annotated_tag_object_id", tag_record["object_id"],
+         "ATTESTATION_TAG_OBJECT_MISMATCH"),
+        ("peeled_target_commit_id", tag_record["peeled_commit"],
+         "ATTESTATION_PEELED_COMMIT_MISMATCH"),
+        ("pre_publication_evidence_commit", tag_record["peeled_commit"],
+         "PREPUBLICATION_COMMIT_MISMATCH"),
+    )
+    for field, expected, code in bindings:
+        if str(attestation.get(field)) != expected:
+            findings.append(finding(
+                code, tag,
+                f"{field} does not match release binding",
+            ))
+
+    if attestation.get("hosting_platform") != "gitea":
+        findings.append(finding(
+            "HOSTING_PLATFORM_MISMATCH", tag,
+            "hosting_platform must be gitea",
+        ))
+    if attestation.get("hosting_platform_release_reference") != release.get("html_url"):
+        findings.append(finding(
+            "RELEASE_REFERENCE_MISMATCH", tag,
+            "Attestation release reference does not match Gitea release URL",
+        ))
+
+    if "attestation_hash" in attestation:
+        findings.append(finding(
+            "ATTESTATION_SELF_REFERENCE", tag,
+            "Attestation must not contain attestation_hash",
+        ))
+
+    declared_assets = attestation.get("assets")
+    if not isinstance(declared_assets, list):
+        findings.append(finding(
+            "ATTESTATION_ASSETS_INVALID", tag,
+            "Attestation assets must be a list",
+        ))
+        declared_assets = []
+
+    declared_by_name = {}
+    for asset in declared_assets:
+        if not isinstance(asset, dict) or not asset.get("name"):
+            findings.append(finding(
+                "ATTESTATION_ASSETS_INVALID", tag,
+                "Each attestation asset must contain name and sha256",
+            ))
+            continue
+        name = asset["name"]
+        if name == ATTESTATION_ASSET:
+            findings.append(finding(
+                "ATTESTATION_SELF_REFERENCE", tag,
+                "Attestation must not list release-attestation.yaml in assets",
+            ))
+            continue
+        if name in declared_by_name:
+            findings.append(finding(
+                "ATTESTATION_ASSET_DUPLICATE", tag,
+                f"Attestation lists payload asset {name} more than once",
+            ))
+        declared_by_name[name] = asset
+
+    published_assets = {}
+    for asset in (release.get("assets") or []):
+        name = asset.get("name")
+        if name == ATTESTATION_ASSET:
+            continue
+        if name in published_assets:
+            findings.append(finding(
+                "PUBLISHED_ASSET_DUPLICATE", tag,
+                f"Gitea release contains payload asset {name} more than once",
+            ))
+        published_assets[name] = asset
+    if set(declared_by_name) != set(published_assets):
+        findings.append(finding(
+            "ASSET_SET_MISMATCH", tag,
+            "Attestation asset names do not equal published payload asset names",
+        ))
+
+    for name in sorted(set(declared_by_name) & set(published_assets)):
+        expected_hash = declared_by_name[name].get("sha256")
+        if not FULL_SHA256.fullmatch(str(expected_hash)):
+            findings.append(finding(
+                "ASSET_HASH_INVALID", tag,
+                f"Asset {name} has no full SHA-256",
+            ))
+            continue
+        actual_hash = hashlib.sha256(
+            client.download_asset(published_assets[name])
+        ).hexdigest()
+        if actual_hash != expected_hash:
+            findings.append(finding(
+                "ASSET_HASH_MISMATCH", tag,
+                f"Asset {name} SHA-256 does not match attestation",
+            ))
+
+    notes_hash = attestation.get("release_notes_hash")
+    actual_notes_hash = hashlib.sha256(
+        release["body"].encode("utf-8")
+    ).hexdigest()
+    if not FULL_SHA256.fullmatch(str(notes_hash)) or notes_hash != actual_notes_hash:
+        findings.append(finding(
+            "RELEASE_NOTES_HASH_MISMATCH", tag,
+            "Published release notes SHA-256 does not match attestation",
+        ))
+
+    evidence_path = attestation.get("pre_publication_evidence_path")
+    evidence_commit = attestation.get("pre_publication_evidence_commit")
+    if not isinstance(evidence_path, str) or not git_path_exists(
+            repo_root, evidence_commit, evidence_path):
+        findings.append(finding(
+            "PREPUBLICATION_EVIDENCE_MISSING", tag,
+            "Pre-publication evidence does not exist in the recorded commit",
+        ))
+
+    try:
+        created = parse_timestamp(attestation["creation_timestamp"])
+        tag_created = parse_timestamp(tag_record["created_at"])
+        release_created = parse_timestamp(release["published_at"])
+        if created < tag_created or created < release_created:
+            findings.append(finding(
+                "ATTESTATION_CREATED_TOO_EARLY", tag,
+                "Attestation predates the tag or hosting-platform release",
+            ))
+    except (KeyError, TypeError, ValueError):
+        findings.append(finding(
+            "ATTESTATION_TIMESTAMP_INVALID", tag,
+            "Attestation, tag, and release timestamps must be ISO 8601",
+        ))
+
+    return findings
+
+
+def audit_tag(repo_root, repository, client, tag_record):
+    tag = tag_record["name"]
+    findings = []
+    if tag_record["object_type"] != "tag":
+        findings.append(finding(
+            "TAG_NOT_ANNOTATED", tag,
+            "Stable release tag must be an annotated tag object",
+        ))
+        return findings
+
+    release = client.get_release(tag)
+    if release is None:
+        return [finding(
+            "RELEASE_MISSING", tag,
+            "Stable annotated tag has no Gitea release",
+        )]
+    if release.get("tag_name") != tag:
+        findings.append(finding(
+            "RELEASE_TAG_MISMATCH", tag,
+            "Gitea release refers to another tag",
+        ))
+    if release.get("draft") or release.get("prerelease"):
+        findings.append(finding(
+            "RELEASE_NOT_STABLE", tag,
+            "Stable tag release must not be draft or prerelease",
+        ))
+    if not str(release.get("body") or "").strip():
+        findings.append(finding(
+            "RELEASE_NOTES_EMPTY", tag,
+            "Gitea release notes are missing or empty",
+        ))
+        return findings
+    if release.get("target_commitish") != tag_record["peeled_commit"]:
+        findings.append(finding(
+            "RELEASE_TARGET_MISMATCH", tag,
+            "Gitea release target is not the full peeled tag commit",
+        ))
+
+    attestation, attestation_finding = load_attestation(client, release, tag)
+    if attestation_finding:
+        findings.append(attestation_finding)
+    else:
+        findings.extend(audit_attestation(
+            repo_root, repository, client, tag_record, release, attestation
+        ))
+    return findings
+
+
+def audit_repository(repo_root, repository, client):
+    repo_root = Path(repo_root).resolve()
+    return [
+        item
+        for tag_record in stable_tags(repo_root)
+        for item in audit_tag(repo_root, repository, client, tag_record)
+    ]
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        description="Audit ACP stable tags against Gitea release attestations"
+    )
+    parser.add_argument("--repo-root", default=".")
+    parser.add_argument("--repository", default="Homelab/ACP")
+    parser.add_argument(
+        "--gitea-api-url",
+        default=os.environ.get("GITEA_API_URL", ""),
+    )
+    parser.add_argument(
+        "--token-env", default="ACP_RELEASE_AUDIT_TOKEN",
+        help="Environment variable containing the read-only Gitea token",
+    )
+    parser.add_argument("--json", action="store_true")
+    args = parser.parse_args(argv)
+
+    token = os.environ.get(args.token_env, "")
+    if not args.gitea_api_url:
+        parser.error("--gitea-api-url or GITEA_API_URL is required")
+    try:
+        client = GiteaClient(args.gitea_api_url, args.repository, token)
+        findings = audit_repository(args.repo_root, args.repository, client)
+    except AuditError as exc:
+        print(f"ERROR: {exc}", file=sys.stderr)
+        return 2
+
+    if args.json:
+        print(json.dumps({
+            "repository": args.repository,
+            "findings": findings,
+            "error_count": len(findings),
+        }, indent=2))
+    else:
+        for item in findings:
+            print(f"[ERROR] [{item['code']}] {item['tag']}: {item['message']}")
+        print(f"\n{len(findings)} release-audit error(s)")
+    return 2 if findings else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
