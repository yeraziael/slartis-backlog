@@ -0,0 +1,81 @@
+import { test, expect } from "@playwright/test";
+import { AuthorizationPage } from "./pages/authorization";
+
+test.describe("PW-I15: Audiobookshelf role and negative authorization", () => {
+  test.describe("denied identity", () => {
+    test("denied user cannot log in", async ({ page }) => {
+      const auth = new AuthorizationPage(page);
+      const success = await auth.tryLogin("pw-e2e-abs-denied", "invalid-placeholder");
+      expect(success).toBeFalsy();
+    });
+
+    test("denied user sees login page after failed attempt", async ({ page }) => {
+      const auth = new AuthorizationPage(page);
+      await auth.tryLogin("pw-e2e-abs-denied", "invalid-placeholder");
+      const onLogin = await auth.isOnLoginPage();
+      expect(onLogin).toBeTruthy();
+    });
+  });
+
+  test.describe("user role", () => {
+    test("user can log in and reach library", async ({ page }) => {
+      const user = process.env.PW_E2E_ABS_USER;
+      const pass = process.env.PW_E2E_ABS_PASSWORD;
+      test.skip(!user || !pass, "credentials required");
+
+      const auth = new AuthorizationPage(page);
+      const success = await auth.tryLogin(user, pass);
+      expect(success).toBeTruthy();
+    });
+
+    test("user cannot see admin section", async ({ page }) => {
+      const user = process.env.PW_E2E_ABS_USER;
+      const pass = process.env.PW_E2E_ABS_PASSWORD;
+      test.skip(!user || !pass, "credentials required");
+
+      const auth = new AuthorizationPage(page);
+      await auth.tryLogin(user, pass);
+      const hasAdmin = await auth.isAdminSectionVisible();
+      expect(hasAdmin).toBeFalsy();
+    });
+  });
+
+  test.describe("admin role", () => {
+    test("admin can log in and reach library", async ({ page }) => {
+      const adminUser = process.env.PW_E2E_ABS_ADMIN_USER || process.env.PW_E2E_ABS_USER;
+      const adminPass = process.env.PW_E2E_ABS_ADMIN_PASSWORD || process.env.PW_E2E_ABS_PASSWORD;
+      test.skip(!adminUser || !adminPass, "admin credentials required");
+
+      const auth = new AuthorizationPage(page);
+      const success = await auth.tryLogin(adminUser, adminPass);
+      expect(success).toBeTruthy();
+    });
+
+    test("admin can see admin section", async ({ page }) => {
+      const adminUser = process.env.PW_E2E_ABS_ADMIN_USER || process.env.PW_E2E_ABS_USER;
+      const adminPass = process.env.PW_E2E_ABS_ADMIN_PASSWORD || process.env.PW_E2E_ABS_PASSWORD;
+      test.skip(!adminUser || !adminPass, "admin credentials required");
+
+      const auth = new AuthorizationPage(page);
+      await auth.tryLogin(adminUser, adminPass);
+      const hasAdmin = await auth.isAdminSectionVisible();
+      expect(hasAdmin).toBeTruthy();
+    });
+  });
+
+  test.describe("malformed auth", () => {
+    test("empty credentials stay on login page", async ({ page }) => {
+      const auth = new AuthorizationPage(page);
+      await auth.tryLogin("", "");
+      const onLogin = await auth.isOnLoginPage();
+      expect(onLogin).toBeTruthy();
+    });
+
+    test("invalid username shows error on Keycloak", async ({ page }) => {
+      const auth = new AuthorizationPage(page);
+      await auth.tryLogin("nonexistent@test.test", "anypassword");
+      const onLogin = await auth.isOnLoginPage();
+      expect(onLogin).toBeTruthy();
+    });
+  });
+});
diff --git a/tests/playwright/services/audiobookshelf/library-playback.spec.ts b/tests/playwright/services/audiobookshelf/library-playback.spec.ts
