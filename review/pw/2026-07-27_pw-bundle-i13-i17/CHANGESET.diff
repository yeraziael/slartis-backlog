@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# PW-I17: post-deployment smoke — runs playwright service tests after deployment
+set -uo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+RUNNER_DIR="$(cd "$SCRIPT_DIR/../runner" && pwd)"
+
+usage() {
+  echo "Usage: $(basename "$0") [service-url]"
+  echo "  Runs playwright service smoke tests after deployment."
+  echo "  If service-url is provided, passes it as service:<url> to the runner."
+  echo "  If omitted, runs service tests without prerequisite checks."
+  exit 2
+}
+
+if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
+  usage
+fi
+
+BASE_URL="${1:-}"
+if [ -n "$BASE_URL" ]; then
+  SUITE="service:${BASE_URL}"
+elif [ "${CI:-}" = "true" ]; then
+  echo "PW-I17: FATAL — SERVICE_URL required in CI, none provided" >&2
+  exit 2
+else
+  SUITE="service"
+fi
+
+echo "PW-I17: post-deployment smoke starting (suite=${SUITE})"
+exec bash "${RUNNER_DIR}/run.sh" "${SUITE}"
