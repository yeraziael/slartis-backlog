@@ -0,0 +1,40 @@
+import { Page } from "@playwright/test";
+
+export class PlayerPage {
+  readonly page: Page;
+
+  constructor(page: Page) {
+    this.page = page;
+  }
+
+  async playButton() {
+    return this.page.getByRole("button", { name: /play/i });
+  }
+
+  async pauseButton() {
+    return this.page.getByRole("button", { name: /pause/i });
+  }
+
+  async isPlaying(): Promise<boolean> {
+    const pause = await this.pauseButton();
+    return (await pause.count()) > 0;
+  }
+
+  async play(): Promise<void> {
+    const play = await this.playButton();
+    const count = await play.count();
+    if (count > 0) {
+      await play.click();
+      await this.page.waitForTimeout(1000);
+    }
+  }
+
+  async pause(): Promise<void> {
+    const pause = await this.pauseButton();
+    const count = await pause.count();
+    if (count > 0) {
+      await pause.click();
+      await this.page.waitForTimeout(500);
+    }
+  }
+}
diff --git a/tests/playwright/services/audiobookshelf/smoke-authenticated.spec.ts b/tests/playwright/services/audiobookshelf/smoke-authenticated.spec.ts
new file mode 100644
index 0000000..8fa03ca
--- /dev/null
+++ b/tests/playwright/services/audiobookshelf/smoke-authenticated.spec.ts
@@ -0,0 +1,104 @@
+import { test, expect } from "@playwright/test";
+import { LoginPage } from "./pages/login";
+
+test.describe("PW-I13: Audiobookshelf authenticated login and logout smoke", () => {
+  test.beforeEach(async ({ page }) => {
+    await page.goto(process.env.SERVICE_URL || "https://audiobookshelf.hl.maier.wtf", { waitUntil: "networkidle" });
+  });
+
+  test("SSO button redirects to Keycloak realm", async ({ page }) => {
+    const login = new LoginPage(page);
+    await login.navigateToRoot();
+    const hasButton = await login.hasKeycloakButton();
+    expect(hasButton).toBeTruthy();
+    const button = await login.getKeycloakButton();
+    await button.click();
+    await page.waitForURL(/realms\/homelab/, { timeout: 15_000 });
+    expect(page.url()).toContain("realms/homelab");
+  });
+
+  test("login with valid credentials lands on service", async ({ page }) => {
+    const user = process.env.PW_E2E_ABS_USER;
+    const pass = process.env.PW_E2E_ABS_PASSWORD;
+    test.skip(!user || !pass, "PW_E2E_ABS_USER and PW_E2E_ABS_PASSWORD must be set");
+
+    const login = new LoginPage(page);
+    await login.navigateToRoot();
+    await (await login.getKeycloakButton()).click();
+    await page.waitForURL(/realms\/homelab/, { timeout: 15_000 });
+
+    await page.fill('input[name="username"]', user);
+    await page.fill('input[name="password"]', pass);
+    await page.getByRole("button", { name: /sign in/i }).click();
+
+    await page.waitForURL("**/audiobookshelf.hl.maier.wtf/**", { timeout: 15_000 });
+    const url = page.url();
+    expect(url).not.toContain("/login");
+    expect(url).not.toContain("/realms/");
+  });
+
+  test("logout terminates session and redirects to login", async ({ page }) => {
+    const user = process.env.PW_E2E_ABS_USER;
+    const pass = process.env.PW_E2E_ABS_PASSWORD;
+    test.skip(!user || !pass, "credentials required");
+
+    const login = new LoginPage(page);
+    await login.navigateToRoot();
+    await (await login.getKeycloakButton()).click();
+    await page.waitForURL(/realms\/homelab/, { timeout: 15_000 });
+    await page.fill('input[name="username"]', user);
+    await page.fill('input[name="password"]', pass);
+    await page.getByRole("button", { name: /sign in/i }).click();
+    await page.waitForURL("**/audiobookshelf.hl.maier.wtf/**", { timeout: 15_000 });
+
+    const logoutLink = page.getByRole("link", { name: /logout/i });
+    await expect(logoutLink).toBeVisible({ timeout: 5_000 });
+    await logoutLink.click();
+    await page.waitForURL(/login|logout/, { timeout: 10_000 });
+    expect(page.url()).not.toContain("audiobookshelf.hl.maier.wtf/");
+  });
+
+  test("post-logout reload stays unauthenticated", async ({ page }) => {
+    const user = process.env.PW_E2E_ABS_USER;
+    const pass = process.env.PW_E2E_ABS_PASSWORD;
+    test.skip(!user || !pass, "credentials required");
+
+    const login = new LoginPage(page);
+    await login.navigateToRoot();
+    await (await login.getKeycloakButton()).click();
+    await page.waitForURL(/realms\/homelab/, { timeout: 15_000 });
+    await page.fill('input[name="username"]', user);
+    await page.fill('input[name="password"]', pass);
+    await page.getByRole("button", { name: /sign in/i }).click();
+    await page.waitForURL("**/audiobookshelf.hl.maier.wtf/**", { timeout: 15_000 });
+
+    const logoutLink = page.getByRole("link", { name: /logout/i });
+    await expect(logoutLink).toBeVisible({ timeout: 5_000 });
+    await logoutLink.click();
+    await page.waitForURL(/login|logout/, { timeout: 10_000 });
+
+    await page.reload();
+    await page.waitForLoadState("networkidle");
+    const url = page.url();
+    const isUnauthenticated =
+      url.includes("/login") || url.includes("/auth/openid") || url.includes("/realms/");
+    expect(isUnauthenticated).toBeTruthy();
+  });
+
+  test("callback failure (wrong credentials) shows error", async ({ page }) => {
+    const login = new LoginPage(page);
+    await login.navigateToRoot();
+    await (await login.getKeycloakButton()).click();
+    await page.waitForURL(/realms\/homelab/, { timeout: 15_000 });
+
+    await page.fill('input[name="username"]', "nonexistent-user");
+    await page.fill('input[name="password"]', "wrong-password");
+    await page.getByRole("button", { name: /sign in/i }).click();
+
+    await page.waitForTimeout(2000);
+    const errorVisible = await page.locator("#kc-error-msg, .alert-error, .kc-feedback-text").first().isVisible().catch(() => false);
+    const url = page.url();
+    const stillOnKeycloak = url.includes("/realms/");
+    expect(errorVisible || stillOnKeycloak).toBeTruthy();
+  });
+});
