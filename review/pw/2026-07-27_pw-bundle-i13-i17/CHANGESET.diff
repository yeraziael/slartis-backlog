--- /dev/null
+++ b/tests/playwright/services/audiobookshelf/pages/library.ts
@@ -0,0 +1,41 @@
+import { Page } from "@playwright/test";
+
+export class LibraryPage {
+  readonly page: Page;
+
+  constructor(page: Page) {
+    this.page = page;
+  }
+
+  async navigateToLibrary(): Promise<void> {
+    const libraryLink = this.page.getByRole("link", { name: /library/i });
+    const count = await libraryLink.count();
+    if (count > 0) {
+      await libraryLink.click();
+      await this.page.waitForLoadState("networkidle");
+    }
+  }
+
+  async getBookCards() {
+    return this.page.locator('[role="listitem"], .book-card, [class*="book"]');
+  }
+
+  async openBook(title: string): Promise<void> {
+    const book = this.page.getByRole("link", { name: new RegExp(title, "i") });
+    const count = await book.count();
+    if (count === 0) {
+      throw new Error(`Book titled "${title}" not found in library`);
+    }
+    await book.first().click();
+    await this.page.waitForLoadState("networkidle");
+  }
+
+  async isOnLibraryPage(): Promise<boolean> {
+    const url = this.page.url();
+    return url.includes("/library") || url.includes("/books");
+  }
+
+  async getBookTitle(): Promise<string> {
+    return (await this.page.locator("h1, h2, [class*='title']").first().textContent()) || "";
+  }
+}
diff --git a/tests/playwright/services/audiobookshelf/pages/player.ts b/tests/playwright/services/audiobookshelf/pages/player.ts
