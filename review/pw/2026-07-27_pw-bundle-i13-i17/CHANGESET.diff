@@ -0,0 +1,38 @@
+import { Page } from "@playwright/test";
+import { LoginPage } from "./login";
+
+export class AuthorizationPage {
+  readonly page: Page;
+
+  constructor(page: Page) {
+    this.page = page;
+  }
+
+  async tryLogin(username: string, password: string): Promise<boolean> {
+    const login = new LoginPage(this.page);
+    await login.navigateToRoot();
+    const hasButton = await login.hasKeycloakButton();
+    if (!hasButton) return false;
+    await (await login.getKeycloakButton()).click();
+    await this.page.waitForURL(/realms\/homelab/, { timeout: 15_000 });
+    await this.page.fill('input[name="username"]', username);
+    await this.page.fill('input[name="password"]', password);
+    await this.page.getByRole("button", { name: /sign in/i }).click();
+    await this.page.waitForURL(/audiobookshelf|realms/, { timeout: 10_000 });
+    return this.page.url().includes("audiobookshelf");
+  }
+
+  async isAdminSectionVisible(): Promise<boolean> {
+    const adminLink = this.page.getByRole("link", { name: /admin|settings|configuration/i });
+    return (await adminLink.count()) > 0;
+  }
+
+  async getAccessibleLinks(): Promise<string[]> {
+    return this.page.locator("nav a, [role='navigation'] a, header a").allTextContents();
+  }
+
+  async isOnLoginPage(): Promise<boolean> {
+    const url = this.page.url();
+    return url.includes("/login") || url.includes("/realms/");
+  }
+}
diff --git a/tests/playwright/services/audiobookshelf/pages/library.ts b/tests/playwright/services/audiobookshelf/pages/library.ts
