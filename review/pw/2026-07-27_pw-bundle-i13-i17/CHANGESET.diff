+import { test, expect } from "@playwright/test";
+import { LoginPage } from "./pages/login";
+import { LibraryPage } from "./pages/library";
+import { PlayerPage } from "./pages/player";
+
+const KNOWN_TITLE = process.env.PW_E2E_KNOWN_TITLE || "Test";
+
+test.describe("PW-I14: Audiobookshelf controlled library and playback", () => {
+  test.beforeEach(async ({ page }) => {
+    const user = process.env.PW_E2E_ABS_USER;
+    const pass = process.env.PW_E2E_ABS_PASSWORD;
+    test.skip(!user || !pass, "PW_E2E_ABS_USER and PW_E2E_ABS_PASSWORD must be set");
+
+    const login = new LoginPage(page);
+    await login.navigateToRoot();
+    await (await login.getKeycloakButton()).click();
+    await page.waitForURL(/realms\/homelab/, { timeout: 15_000 });
+    await page.fill('input[name="username"]', user);
+    await page.fill('input[name="password"]', pass);
+    await page.getByRole("button", { name: /sign in/i }).click();
+    await page.waitForURL("**/audiobookshelf.hl.maier.wtf/**", { timeout: 15_000 });
+  });
+
+  test("library page shows book cards after login", async ({ page }) => {
+    const library = new LibraryPage(page);
+    await library.navigateToLibrary();
+    const cards = await library.getBookCards();
+    expect(await cards.count()).toBeGreaterThan(0);
+  });
+
+  test("known title opens and displays book detail", async ({ page }) => {
+    const library = new LibraryPage(page);
+    await library.navigateToLibrary();
+    await library.openBook(KNOWN_TITLE);
+    const title = await library.getBookTitle();
+    expect(title.length).toBeGreaterThan(0);
+  });
+
+  test("play button starts playback", async ({ page }) => {
+    const library = new LibraryPage(page);
+    const player = new PlayerPage(page);
+    await library.navigateToLibrary();
+    await library.openBook(KNOWN_TITLE);
+    await player.play();
+    expect(await player.isPlaying()).toBeTruthy();
+  });
+
+  test("pause button stops playback", async ({ page }) => {
+    const library = new LibraryPage(page);
+    const player = new PlayerPage(page);
+    await library.navigateToLibrary();
+    await library.openBook(KNOWN_TITLE);
+    await player.play();
+    expect(await player.isPlaying()).toBeTruthy();
+    await player.pause();
+    expect(await player.isPlaying()).toBeFalsy();
+  });
+});
