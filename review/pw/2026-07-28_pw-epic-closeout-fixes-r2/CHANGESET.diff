+"""Extract final Playwright test counts from the JSON reporter output."""
+
+import json
+import sys
+
+
+def iter_tests(suite):
+    for spec in suite.get("specs", []):
+        yield from spec.get("tests", [])
+    for child in suite.get("suites", []):
+        yield from iter_tests(child)
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit("Usage: result-summary.py <playwright-report.json>")
+
+    with open(sys.argv[1], encoding="utf-8") as handle:
+        report = json.load(handle)
+
+    counts = {
+        "total": 0,
+        "passed": 0,
+        "failed": 0,
+        "prerequisite_errors": 0,
+        "skipped": 0,
+    }
+    for suite in report.get("suites", []):
+        for test in iter_tests(suite):
+            results = test.get("results", [])
+            status = results[-1].get("status") if results else "skipped"
+            counts["total"] += 1
+            if status == "passed":
+                counts["passed"] += 1
+            elif status == "skipped":
+                counts["skipped"] += 1
+            else:
+                counts["failed"] += 1
+
+    print(json.dumps(counts, separators=(",", ":")))
+
+
+if __name__ == "__main__":
+    main()
