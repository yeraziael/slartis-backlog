+import { test, expect } from "@playwright/test";
+import { JellyfinMediaPage } from "./pages/media";
+import { JellyfinLoginPage } from "./pages/login";
+
+test.describe("PW-I21: Jellyfin controlled media and playback flow", () => {
+  test("Jellyfin opens controlled media and initiates playback (fail-closed)", { tag: "@media" }, async ({ page }) => {
+    const user = process.env.PW_E2E_JF_USER;
+    const pass = process.env.PW_E2E_JF_PASSWORD;
+    test.skip(!user || !pass, "Jellyfin user credentials required");
+
+    const loginPage = new JellyfinLoginPage(page);
+    await loginPage.login(user, pass);
+
+    const mediaPage = new JellyfinMediaPage(page);
+    await mediaPage.openControlledMedia();
+    await mediaPage.startPlayback();
+    await mediaPage.stopPlayback();
+  });
+});
