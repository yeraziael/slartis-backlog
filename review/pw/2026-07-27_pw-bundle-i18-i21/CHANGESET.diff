+import { Page, expect } from "@playwright/test";
+
+export class JellyfinMediaPage {
+  readonly page: Page;
+
+  constructor(page: Page) {
+    this.page = page;
+  }
+
+  async openControlledMedia(): Promise<void> {
+    const mediaItem = this.page.locator('[data-testid="controlled-media-item"], a:has-text("Controlled Media")');
+    await expect(mediaItem.first()).toBeVisible({ timeout: 10000 });
+    await mediaItem.first().click();
+  }
+
+  async startPlayback(): Promise<void> {
+    const playBtn = this.page.locator('button:has-text("Play"), [data-testid="play-button"]');
+    await expect(playBtn.first()).toBeVisible({ timeout: 10000 });
+    await playBtn.first().click();
+
+    // Fail-closed assertion: verify video/audio player element is active
+    const activePlayer = this.page.locator('video, audio, [data-testid="active-player"]');
+    await expect(activePlayer.first()).toBeVisible({ timeout: 15000 });
+  }
+
+  async stopPlayback(): Promise<void> {
+    const stopBtn = this.page.locator('button:has-text("Stop"), [data-testid="stop-button"]');
+    if (await stopBtn.count() > 0) {
+      await stopBtn.first().click();
+    }
+  }
+}
