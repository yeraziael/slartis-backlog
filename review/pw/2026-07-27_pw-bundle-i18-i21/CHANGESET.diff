+#!/usr/bin/env python3
+"""Static policy tests for Playwright maintenance, flake, quarantine, and ownership (PW-I18)."""
+
+import os
+import unittest
+
+REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+DOCS_OPERATIONS = os.path.join(REPO_ROOT, "docs", "playwright-operations.md")
+
+class TestPlaywrightOperationsPolicy(unittest.TestCase):
+    def test_operations_doc_exists(self):
+        self.assertTrue(os.path.isfile(DOCS_OPERATIONS), f"Missing {DOCS_OPERATIONS}")
+
+    def test_operations_doc_contains_quarantine_rules(self):
+        with open(DOCS_OPERATIONS) as f:
+            content = f.read()
+        self.assertIn("14-day", content.lower())
+        self.assertIn("quarantine", content.lower())
+        self.assertIn("flake", content.lower())
+        self.assertIn("owner", content.lower())
+
+if __name__ == "__main__":
+    unittest.main()
