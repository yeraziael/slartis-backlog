@@ -0,0 +1,75 @@
+import { Page, expect } from "@playwright/test";
+
+export class JellyfinLoginPage {
+  readonly page: Page;
+
+  constructor(page: Page) {
+    this.page = page;
+  }
+
+  async goto() {
+    await this.page.goto("/web/index.html");
+  }
+
+  async verifyLoaded() {
+    await expect(this.page).toHaveURL(/web/);
+  }
+
+  async login(username: string, pass: string): Promise<void> {
+    await this.goto();
+    const userField = this.page.locator('input[name="username"], input[id*="username"]');
+    const passField = this.page.locator('input[name="password"], input[id*="password"]');
+    const submitBtn = this.page.locator('button[type="submit"], button:has-text("Sign In"), button:has-text("Login")');
+
+    await expect(userField).toBeVisible({ timeout: 10000 });
+    await userField.fill(username);
+    await passField.fill(pass);
+    await submitBtn.click();
+    
+    const userHeader = this.page.locator('.headerUserButton, [data-testid="user-menu"], .mainDrawer');
+    await expect(userHeader.first()).toBeVisible({ timeout: 15000 });
+  }
+
+  async logout(): Promise<void> {
+    const userMenu = this.page.locator('[data-testid="user-menu"], .headerUserButton, button[aria-label="User"]');
+    if (await userMenu.count() > 0) {
+      await userMenu.first().click();
+    }
+    const logoutBtn = this.page.locator('button:has-text("Sign Out"), button:has-text("Logout"), [data-testid="logout-button"]');
+    await expect(logoutBtn).toBeVisible({ timeout: 5000 });
+    await logoutBtn.click();
+    
+    const userField = this.page.locator('input[name="username"], input[id*="username"]');
+    await expect(userField).toBeVisible({ timeout: 10000 });
+  }
+
+  async isOnLoginPage(): Promise<boolean> {
+    const userField = this.page.locator('input[name="username"], input[id*="username"]');
+    return await userField.isVisible().catch(() => false);
+  }
+
+  async isAdminSectionVisible(): Promise<boolean> {
+    const adminLink = this.page.locator('a:has-text("Dashboard"), a:has-text("Administration"), [data-testid="admin-section"]');
+    return await adminLink.isVisible().catch(() => false);
+  }
+
+  async navigateToProtectedLibrary(libraryId: string): Promise<void> {
+    // Navigate using deterministic controlled test-data contract route/ID per PW-D06
+    await this.page.goto(`/web/index.html#!/item.html?id=${libraryId}`);
+  }
+
+  async isProtectedLibraryAccessible(libraryId: string): Promise<boolean> {
+    await this.navigateToProtectedLibrary(libraryId);
+    const mediaContainer = this.page.locator('.detailSection, .listItem, [data-testid="media-item-detail"]');
+    return await mediaContainer.first().isVisible().catch(() => false);
+  }
+
+  async isProtectedLibraryDenied(libraryId: string): Promise<boolean> {
+    await this.navigateToProtectedLibrary(libraryId);
+    // Fail-closed denial check: verify unauthorized message, error notification, or redirection away from item
+    const errorBanner = this.page.locator(':text("Unauthorized"), :text("Access Denied"), :text("Forbidden"), :text("Item not found"), .toastErrorMessage');
+    const isErrorVisible = await errorBanner.isVisible().catch(() => false);
+    const isDetailVisible = await this.page.locator('.detailSection, [data-testid="media-item-detail"]').isVisible().catch(() => false);
+    return isErrorVisible || !isDetailVisible;
+  }
+}
