+import { test, expect } from "@playwright/test";
+import { JellyfinLoginPage } from "./pages/login";
+
+test.describe("PW-I20: Jellyfin authentication, role coverage, and logout", () => {
+  test("Jellyfin standard user authentication, library access, and logout", { tag: "@auth" }, async ({ page }) => {
+    const user = process.env.PW_E2E_JF_USER;
+    const pass = process.env.PW_E2E_JF_PASSWORD;
+    test.skip(!user || !pass, "Jellyfin user credentials required");
+
+    const loginPage = new JellyfinLoginPage(page);
+    await loginPage.login(user, pass);
+    const onLogin = await loginPage.isOnLoginPage();
+    expect(onLogin).toBeFalsy();
+
+    await loginPage.logout();
+    const backOnLogin = await loginPage.isOnLoginPage();
+    expect(backOnLogin).toBeTruthy();
+  });
+
+  test("Jellyfin restricted user role denial with positive control", { tag: "@auth" }, async ({ page }) => {
+    const restrictedUser = process.env.PW_E2E_JF_RESTRICTED_USER;
+    const restrictedPass = process.env.PW_E2E_JF_RESTRICTED_PASSWORD;
+    const standardUser = process.env.PW_E2E_JF_USER;
+    const standardPass = process.env.PW_E2E_JF_PASSWORD;
+    const protectedLibraryId = process.env.PW_E2E_JF_RESTRICTED_LIBRARY_ID || "controlled-test-item-id";
+    test.skip(!restrictedUser || !restrictedPass || !standardUser || !standardPass, "Jellyfin restricted and standard credentials required");
+
+    // Positive control: standard/authorized user can access protected resource
+    const standardLoginPage = new JellyfinLoginPage(page);
+    await standardLoginPage.login(standardUser, standardPass);
+    const standardCanAccess = await standardLoginPage.isProtectedLibraryAccessible(protectedLibraryId);
+    expect(standardCanAccess).toBeTruthy();
+
+    // Negative authorization test: restricted user cannot access protected resource
+    const restrictedLoginPage = new JellyfinLoginPage(page);
+    await restrictedLoginPage.login(restrictedUser, restrictedPass);
+    const restrictedDenied = await restrictedLoginPage.isProtectedLibraryDenied(protectedLibraryId);
+    expect(restrictedDenied).toBeTruthy();
+  });
+
+  test("Jellyfin admin navigation check", { tag: "@auth" }, async ({ page }) => {
+    const adminUser = process.env.PW_E2E_JF_ADMIN_USER;
+    const adminPass = process.env.PW_E2E_JF_ADMIN_PASSWORD;
+    test.skip(!adminUser || !adminPass, "Jellyfin admin credentials required");
+
+    const loginPage = new JellyfinLoginPage(page);
+    await loginPage.login(adminUser, adminPass);
+    const hasAdmin = await loginPage.isAdminSectionVisible();
+    expect(hasAdmin).toBeTruthy();
+  });
+});
