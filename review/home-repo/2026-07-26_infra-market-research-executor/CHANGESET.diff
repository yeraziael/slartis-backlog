+#!/bin/bash
+set -euo pipefail
+
+export HOME=/home/lydia
+export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/lydia/.opencode/bin
+
+REPO_DIR=/home/lydia/workspace/repos/infra
+LOG=/tmp/infra-market-research-$(date +%Y%m%d%H%M%S).log
+
+mkdir -p /tmp
+echo "=== infra-market-research started at $(date +%Y-%m-%dT%H:%M:%SZ) ===" > "$LOG"
+
+cd "$REPO_DIR" 2>/dev/null || {
+  echo "Cloning infra repo..." >> "$LOG"
+  git clone ssh://git@192.168.2.30:2222/yeraziael/infra.git "$REPO_DIR" >> "$LOG" 2>&1
+  cd "$REPO_DIR"
+}
+if ! git pull --ff-only origin main >> "$LOG" 2>&1; then
+  echo "ERROR: git pull failed (diverged or network error)" >> "$LOG"
+  exit 1
+fi
+
+RESEARCH_CMD="${RESEARCH_CMD:-/home/lydia/.opencode/bin/opencode}"
+RESEARCH_ARGS="${RESEARCH_ARGS:---auto --format json --dir /home/lydia/workspace/repos/infra \"Fuehre die taegliche Marktforschung fuer Issue #1 aus. Bearbeite nur rack_and_chassis. Preise an der Quelle verifizieren. Findings nach findings/current/. README.md Dashboard aktualisieren. Direkt auf main pushen.\"}"
+
+echo "Running opencode headless..." >> "$LOG"
+set +e
+script -qec "$RESEARCH_CMD $RESEARCH_ARGS" /dev/null >> "$LOG" 2>&1
+OPENCODE_EXIT=$?
+set -e
+echo "opencode exit: $OPENCODE_EXIT" >> "$LOG"
+echo "=== infra-market-research finished at $(date -Iseconds) (exit: $OPENCODE_EXIT) ===" >> "$LOG"
+
+exit $OPENCODE_EXIT
